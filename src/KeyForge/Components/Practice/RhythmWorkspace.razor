@using KeyForge.Features.Exercises.Models
@using KeyForge.Features.Practice.Models
@using KeyForge.Features.Practice.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject MidiInputRouter MidiInput

<div id="@_workspaceId"
     class="kf-practice-workspace rhythm-workspace"
     data-state="ready"
     tabindex="-1"
     aria-labelledby="@($"{_workspaceId}-title")">
    <div class="kf-practice-workspace__header rhythm-workspace__header">
        <div>
            <p class="kf-meta">@UiText.RhythmPractice</p>
            <h2 id="@($"{_workspaceId}-title")" class="kf-card__title">@RuntimeExercise.Definition.Title</h2>
        </div>
        <span class="kf-status-badge kf-status-badge--available" data-rhythm-state>
            @UiText.RhythmReady
        </span>
    </div>

    <div class="rhythm-workspace__pulse" aria-live="polite" aria-atomic="true">
        <strong data-rhythm-countdown>@UiText.RhythmReady</strong>
        <span class="kf-text-secondary">@UiText.GetBpmLabel(RuntimeExercise.SelectedBpm ?? 0)</span>
        <span class="kf-text-secondary">@UiText.GetCountInLabel(RuntimeExercise.Definition.Metronome is { Enabled: true } config ? config.CountInBeats : 0)</span>
    </div>

    <div class="rhythm-workspace__instruction">
        <kbd>K</kbd>
        <span>@(HasAuthoredPattern ? UiText.PlayAuthoredRhythm : UiText.PressKOnEachBeat)</span>
        <span class="kf-meta">
            @UiText.CapturedHits: <bdi data-rhythm-hit-count>@UiText.FormatNumber(0)</bdi>
        </span>
    </div>

    <label class="kf-meta">@UiText.RhythmTimingReference
        <select value="@(_firstMidiNoteMode ? "FirstMidiNote" : "LocalStart")" @onchange="HandleTimingModeChanged"
                disabled="@(!_compatibleWithFirstMidiNote || _started)">
            <option value="LocalStart">@UiText.LocalStartTiming</option>
            <option value="FirstMidiNote">@UiText.FirstMidiNoteTiming</option>
        </select>
    </label>
    <p class="kf-text-muted" role="note">@(_firstMidiNoteMode ? UiText.FirstMidiNoteTimingDescription : UiText.LocalStartTimingDescription)</p>

    @if (HasAuthoredPattern)
    {
        <VexFlowStaff Rhythm="RuntimeExercise.Challenge.Rhythm" TimeSignature="@(((RhythmExerciseDefinition)RuntimeExercise.Definition).Unmetered ? string.Empty : ((RhythmExerciseDefinition)RuntimeExercise.Definition).TimeSignature)" />
    }

    <ol class="rhythm-beats @(HasAuthoredPattern ? "rhythm-beats--authored" : null)" dir="ltr" aria-label="@UiText.BeatProgression">
        @for (var index = 0; index < TimelineEvents.Count; index++)
        {
            var timelineEvent = TimelineEvents[index];
            <li data-rhythm-beat="@index" class="@(timelineEvent.IsRest ? "is-rest" : null)" title="@GetRhythmLabel(timelineEvent)">
                <span>@UiText.FormatNumber(index + 1)</span>
                @if (HasAuthoredPattern)
                {
                    <span class="kf-meta">@GetRhythmLabel(timelineEvent)</span>
                    <span class="kf-meta">@UiText.FormatTimingError(timelineEvent.StartOffset.TotalMilliseconds)</span>
                }
            </li>
        }
    </ol>

    <div class="kf-progress"
         role="progressbar"
         aria-label="@UiText.RhythmProgress"
         aria-valuemin="0"
         aria-valuemax="100"
         aria-valuenow="0"
         data-rhythm-progress>
        <div class="kf-progress__value" style="--kf-progress-value: 0%"></div>
    </div>

    @if (RuntimeExercise.Definition.Tempo is not null)
    {
        <TempoSelector RuntimeExercise="RuntimeExercise"
                       IsDisabled="@(_started || _metronomeRunning)"
                       OnTempoChanged="HandleTempoChanged" />
    }

    @if (!_started)
    {
        <button class="kf-button kf-button--primary" type="button" @onclick="StartTimelineAsync">
            @UiText.StartRhythm
        </button>
    }

    @if (_startFailed)
    {
        <p class="rhythm-workspace__error" role="alert">@UiText.RhythmStartError</p>
    }
    @if (_pausedForMidi)
    {
        <p class="rhythm-workspace__error" role="status" data-midi-disconnect-pause>@UiText.MidiPerformancePaused</p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required RuntimeExercise RuntimeExercise { get; set; }

    [Parameter, EditorRequired]
    public required EventCallback<DateTime> OnCompleted { get; set; }

    [Parameter]
    public bool MetronomeAudioEnabled { get; set; } = true;

    [Parameter]
    public bool PreferFirstMidiNote { get; set; }

    private readonly string _workspaceId = $"rhythm-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<RhythmWorkspace>? _dotNetReference;
    private DateTime _timelineStartedAt;
    private double? _browserTimelineOriginMilliseconds;
    private int _runVersion;
    private bool _started;
    private bool _isActive;
    private bool _startFailed;
    private bool _metronomeRunning;
    private bool _pausedForMidi;
    private bool _firstMidiNoteMode;
    private bool _firstMidiRunArmed;
    private bool _compatibleWithFirstMidiNote;
    private IDisposable? _midiRegistration;

    private IReadOnlyList<RhythmTimelineEvent> TimelineEvents => RuntimeExercise.Challenge.Rhythm?.Events ?? [];
    private IReadOnlyList<TimeSpan> PulseOffsets => RuntimeExercise.Challenge.Rhythm?.PulseOffsets ?? [];
    private TimeSpan TimelineDuration => RuntimeExercise.Challenge.Rhythm?.Duration ?? TimeSpan.Zero;
    private bool HasAuthoredPattern => RuntimeExercise.Definition is RhythmExerciseDefinition { Pattern: not null } or RhythmExerciseDefinition { Measures: not null };

    private Task HandleTempoChanged(int _) => InvokeAsync(StateHasChanged);

    private Task HandleMetronomeRunningChanged(bool isRunning)
    {
        _metronomeRunning = isRunning;
        return InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        var attacks = RuntimeExercise.Challenge.ExpectedInputs.Where(input => input.Type == InputEventType.Beat && input.ExpectedOffset.HasValue).OrderBy(input => input.ExpectedOffset).ToArray();
        _compatibleWithFirstMidiNote = attacks.Length >= 2 && attacks[0].ExpectedOffset == TimeSpan.Zero &&
            RuntimeExercise.Challenge.Rhythm?.Events.FirstOrDefault()?.IsRest != true;
        _firstMidiNoteMode = PreferFirstMidiNote && _compatibleWithFirstMidiNote;
        _midiRegistration = MidiInput.Register(HandleMidiMessageAsync);
        MidiInput.SelectedDeviceStateChanged += HandleMidiDeviceStateChanged;
    }

    private void HandleTimingModeChanged(ChangeEventArgs args) =>
        _firstMidiNoteMode = _compatibleWithFirstMidiNote && string.Equals(args.Value?.ToString(), "FirstMidiNote", StringComparison.Ordinal);

    private async Task StartTimelineAsync()
    {
        if (_started)
        {
            return;
        }

        if (_pausedForMidi)
        {
            RuntimeExercise.ResetCapturedInputs();
            _browserTimelineOriginMilliseconds = null;
            MidiInput.SetTimelineOrigin(null);
        }
        _pausedForMidi = false;
        var startedFromCountIn = _metronomeRunning;
        _runVersion++;
        _started = true;
        _startFailed = false;
        if (!startedFromCountIn)
        {
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/Practice/RhythmWorkspace.razor.js");
            _dotNetReference ??= DotNetObjectReference.Create(this);

            await _module.InvokeVoidAsync(
                "startRhythm",
                _workspaceId,
                _dotNetReference,
                TimelineEvents.Select(item => new
                {
                    offsetMilliseconds = item.StartOffset.TotalMilliseconds,
                    isRest = item.IsRest
                }).ToArray(),
                PulseOffsets.Select(offset => offset.TotalMilliseconds).ToArray(),
                TimelineDuration.TotalMilliseconds,
                new
                {
                    runVersion = _runVersion,
                    active = UiText.RhythmActive,
                    evaluating = UiText.EvaluatingRhythm,
                    digits = UiText.NumeralDigits,
                    countInBeats = RuntimeExercise.Definition.Metronome is { Enabled: true } config ? config.CountInBeats : 0,
                    beatIntervalMilliseconds = 60000d / (RuntimeExercise.SelectedBpm ?? RuntimeExercise.Definition.Tempo!.DefaultBpm),
                    audio = !_firstMidiNoteMode && MetronomeAudioEnabled && RuntimeExercise.Definition.Metronome?.Audio != false,
                    firstMidiNote = _firstMidiNoteMode,
                    waiting = UiText.WaitingForFirstMidiNote
                });
            _firstMidiRunArmed = _firstMidiNoteMode;
        }
        catch (JSException)
        {
            _started = false;
            _startFailed = true;
        }
    }

    private static string GetRhythmLabel(RhythmTimelineEvent item) =>
        UiText.GetRhythmEventLabel(item.Duration, item.IsRest);

    [JSInvokable]
    public Task NotifyRhythmStarted(double browserTimestampMilliseconds, int runVersion)
    {
        if (!_started || runVersion != _runVersion) return Task.CompletedTask;
        _timelineStartedAt = DateTime.UtcNow;
        _browserTimelineOriginMilliseconds = browserTimestampMilliseconds;
        MidiInput.SetTimelineOrigin(browserTimestampMilliseconds);
        _isActive = true;
        return Task.CompletedTask;
    }

    private void HandleMidiDeviceStateChanged(string? deviceId, bool connected)
    {
        if (connected || !_started) return;
        _ = InvokeAsync(PauseForMidiDisconnectAsync);
    }

    private async Task PauseForMidiDisconnectAsync()
    {
        if (!_started) return;
        _runVersion++;
        _started = false;
        _isActive = false;
        _firstMidiRunArmed = false;
        _pausedForMidi = true;
        RuntimeExercise.ResetCapturedInputs();
        MidiInput.SetTimelineOrigin(null);
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("setRhythmPaused", _workspaceId, UiText.RhythmReady);
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task CaptureRhythmKeyboardInput(
        string code,
        bool isRepeat,
        double elapsedMilliseconds, int runVersion)
    {
        if (runVersion != _runVersion) return Task.CompletedTask;
        var inputEvent = RhythmKeyboardInputAdapter.Create(
            code,
            isRepeat,
            _isActive,
            elapsedMilliseconds,
            _timelineStartedAt);

        if (inputEvent is not null)
        {
            RuntimeExercise.CaptureInput(inputEvent);
        }

        return Task.CompletedTask;
    }

    private async Task HandleMidiMessageAsync(MidiInputMessage message)
    {
        if (!_started || !MidiInput.Accepts(message)) return;
        if (_firstMidiNoteMode && !_isActive)
        {
            if (!_firstMidiRunArmed) return;
            if (!MidiInputAdapter.IsNoteOn(message) || !double.IsFinite(message.TimestampMilliseconds) || message.TimestampMilliseconds < 0) return;
            _firstMidiRunArmed = false;
            _browserTimelineOriginMilliseconds = message.TimestampMilliseconds;
            MidiInput.SetTimelineOrigin(message.TimestampMilliseconds);
            _timelineStartedAt = DateTime.UtcNow;
            _isActive = true;
            CaptureMidi(message, message.TimestampMilliseconds, isTimingReference: true);
            if (_module is not null) await _module.InvokeVoidAsync("startRhythmAt", _workspaceId, message.TimestampMilliseconds, _runVersion);
            await InvokeAsync(StateHasChanged);
            return;
        }
        if (!_isActive || _browserTimelineOriginMilliseconds is not { } origin) return;
        CaptureMidi(message, origin);
    }

    private void CaptureMidi(MidiInputMessage message, double origin, bool isTimingReference = false)
    {
        var midiEvent = MidiInputAdapter.TryCreate(message, DateTime.UtcNow, origin);
        if (midiEvent is null) return;
        RuntimeExercise.CaptureMidiEvent(midiEvent);
        var inputEvent = MidiInputAdapter.TryCreateBeat(message, _isActive, DateTime.UtcNow, origin, isTimingReference);
        if (inputEvent is not null)
        {
            RuntimeExercise.CaptureInput(inputEvent);
        }
    }

    [JSInvokable]
    public async Task CompleteRhythm(int runVersion)
    {
        if (!_isActive || runVersion != _runVersion)
        {
            return;
        }

        _isActive = false;
        await OnCompleted.InvokeAsync(DateTime.UtcNow);
    }

    public async ValueTask DisposeAsync()
    {
        _runVersion++;
        _isActive = false;
        MidiInput.SelectedDeviceStateChanged -= HandleMidiDeviceStateChanged;
        _midiRegistration?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stopRhythm", _workspaceId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone; browser resources disappear with it.
            }
        }

        _dotNetReference?.Dispose();
    }
}
