@namespace KeyForge.Components.Practice
<div class="kf-card__body">
    <p>@UiText.ExtraInputs: @Details.ExtraNotes</p>
    <p>@ReleaseLabel(PerformanceReleaseAccuracy.Missing): @Details.UnexpectedReleases</p>
    @foreach (var note in Details.Notes)
    {
        <p><bdi>@note.Pitch</bdi> (@note.Voice / @UiText.GetPracticeHand(note.Hand)): @(note.IsCorrect ? UiText.CorrectAnswer : UiText.IncorrectAnswer)
            <bdi>@note.OnsetErrorMilliseconds?.ToString("+0.##;-0.##;0") ms</bdi>
            @if (note.IsVelocityCorrect is { } velocityCorrect)
            {
                <span>@(velocityCorrect ? T("شدت صحیح /", "Dynamics correct /") : T("شدت نادرست /", "Dynamics incorrect /")) <bdi>@note.RelativeVelocity?.ToString("0.##")</bdi></span>
            }
            @if (note.ReleaseAccuracy != PerformanceReleaseAccuracy.NotScored)
            {
                <span>@ReleaseLabel(note.ReleaseAccuracy) <bdi>@note.DurationErrorMilliseconds?.ToString("+0.##;-0.##;0") ms</bdi></span>
            }
        </p>
    }
</div>
@code {
    private static string T(string fa, string en) => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa" ? fa : en;
    private static string ReleaseLabel(PerformanceReleaseAccuracy accuracy) => accuracy switch
    {
        PerformanceReleaseAccuracy.Correct => T("رهاسازی صحیح /", "Release correct /"),
        PerformanceReleaseAccuracy.Early => T("رهاسازی زودهنگام /", "Early release /"),
        PerformanceReleaseAccuracy.Late => T("رهاسازی دیرهنگام /", "Late release /"),
        _ => T("رهاسازی ثبت‌نشده یا غیرمنتظره /", "Missing or unexpected release /")
    };
    [Parameter, EditorRequired] public PerformanceEvaluationDetails Details { get; set; } = null!;
}
