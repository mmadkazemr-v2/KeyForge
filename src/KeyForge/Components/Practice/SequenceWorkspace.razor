@namespace KeyForge.Components.Practice
@implements IDisposable
@inject MidiInputRouter MidiInput

<div class="kf-practice-workspace sequence-workspace" tabindex="0" @onkeydown="HandleKeyDown" aria-labelledby="sequence-title">
    <header class="kf-practice-workspace__header">
        <div>
            <p class="kf-meta">@PracticeLabel</p>
            <h2 id="sequence-title" class="kf-card__title">@Instruction</h2>
            <p class="kf-card__description">@Description</p>
        </div>
        <span class="kf-status-badge kf-status-badge--available">@UiText.GetQuestionPosition(CurrentStep, StepCount)</span>
    </header>

    <div class="kf-practice-workspace__progress">
        <span class="kf-meta">@UiText.SequenceProgress</span>
        <div class="kf-progress" role="progressbar" aria-label="@UiText.SequenceProgress" aria-valuemin="0" aria-valuemax="@StepCount" aria-valuenow="@CompletedStepCount">
            <div class="kf-progress__value" style="@($"--kf-progress-value: {ProgressPercent}%")"></div>
        </div>
    </div>

    <dl class="kf-practice-summary sequence-workspace__configuration">
        @if (IsSpeed)
        {
            <div><dt>@UiText.SpeedPatternLabel</dt><dd>@UiText.GetSpeedPattern(SpeedDetails.Pattern)</dd></div>
        }
        else
        {
            @if (IsFingerIndependence)
            {
                <div><dt>@UiText.Hand</dt><dd>@UiText.GetPracticeHand(FingerDetails.Hand)</dd></div>
                <div><dt>@UiText.Fingers</dt><dd><bdi>@FingerList</bdi></dd></div>
            }
            else if (ActiveScale is { } scale)
            {
                <div><dt>@UiText.Scale</dt><dd><bdi>@ScaleLabel</bdi></dd></div>
                @if (HasSelectableScaleHand)
                {
                    <div class="sequence-workspace__hand-picker">
                        <dt><label for="scale-practice-hand">@UiText.SelectPracticeHand</label></dt>
                        <dd>
                            <select id="scale-practice-hand" value="@_selectedScaleHand" @onchange="HandleScaleHandChanged">
                                <option value="@PracticeHand.Right">@UiText.GetPracticeHand(PracticeHand.Right)</option>
                                <option value="@PracticeHand.Left">@UiText.GetPracticeHand(PracticeHand.Left)</option>
                            </select>
                        </dd>
                    </div>
                }
            }
        }
        @if (RuntimeExercise.SelectedBpm is { } bpm)
        {
            <div><dt>@UiText.Tempo</dt><dd><bdi>@UiText.GetBpmLabel(bpm)</bdi></dd></div>
        }
    </dl>

    <section class="sequence-workspace__sequence" aria-label="@UiText.ExpectedSequence">
        @for (var index = 0; index < StepCount; index++)
        {
            <span class="@GetStepClass(index)">
                <bdi>@ExpectedNotes[index]</bdi>
                @if (HasSelectableScaleHand)
                {
                    <small>@UiText.FormatNumber(GetSuggestedFinger(index))</small>
                }
            </span>
        }
    </section>
    @if (HasSelectableScaleHand)
    {
        <p class="kf-text-secondary sequence-workspace__fingering-note">@UiText.FingeringGuidanceOnly</p>
    }

    @if (RuntimeExercise.Definition.Tempo is not null)
    {
        <TempoSelector RuntimeExercise="RuntimeExercise" IsDisabled="@(_isActive || _metronomeRunning)" OnTempoChanged="HandleTempoChanged" />
    }

    @if (!_isActive && !_completed && RuntimeExercise.Definition.Metronome is { Enabled: true } metronome)
    {
        <MetronomeControl RuntimeExercise="RuntimeExercise" Configuration="metronome" AudioEnabled="MetronomeAudioEnabled"
                          StopAfterCountIn="true" OnCountInCompleted="StartSequenceAsync" OnRunningChanged="HandleMetronomeRunningChanged" />
    }
    else if (!_isActive && !_completed)
    {
        <button class="kf-button kf-button--primary" type="button" @onclick="StartSequenceAsync">@UiText.StartPractice</button>
    }
    @if (_pausedForMidi)
    {
        <p class="kf-practice-feedback" role="status" data-midi-disconnect-pause>@UiText.MidiPerformancePaused</p>
    }

    @if (_isActive)
    {
        <section class="kf-practice-input sequence-workspace__input" aria-live="polite">
            <p class="kf-meta">@UiText.CurrentExpectedInput</p>
            <strong><bdi>@ExpectedNotes[ProgressIndex]</bdi></strong>
            @if (HasSelectableScaleHand)
            {
                <p class="sequence-workspace__suggested-finger">@UiText.SuggestedFinger: <bdi>@UiText.FormatNumber(GetSuggestedFinger(ProgressIndex))</bdi></p>
            }
            <p class="kf-text-secondary">@UiText.SelectPianoNote</p>
            <PianoKeyboard FirstNote="FirstPianoNote" LastNote="LastPianoNote" SelectedNote="_lastSelectedNote" Disabled="false" OnNoteSelected="HandlePianoNote" />
            @if (_lastInputCorrect is not null)
            {
                <p class="@(_lastInputCorrect == true ? "sequence-workspace__live-feedback sequence-workspace__live-feedback--correct" : "sequence-workspace__live-feedback sequence-workspace__live-feedback--incorrect")" role="status">@GetLiveFeedback()</p>
            }
            @if (IsAuthoredSequence)
            {
                <button class="kf-button kf-button--secondary" type="button" @onclick="RestartScalePractice">@(ActiveScale is null ? UiText.RestartSequence : UiText.RestartScale)</button>
            }
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public RuntimeExercise RuntimeExercise { get; set; } = null!;
    [Parameter] public EventCallback<DateTime> OnCompleted { get; set; }
    [Parameter] public bool MetronomeAudioEnabled { get; set; } = true;
    private DateTime _timelineStartedAt;
    private double? _browserTimelineOriginMilliseconds;
    private int _stepIndex;
    private bool _isActive;
    private bool _completed;
    private bool _pausedForMidi;
    private bool _metronomeRunning;
    private bool? _lastInputCorrect;
    private bool _lastInputOctaveMismatch;
    private MusicalNote? _lastSelectedNote;
    private PracticeHand _selectedScaleHand = PracticeHand.Right;
    private IDisposable? _midiRegistration;
    private bool IsSpeed => RuntimeExercise.Definition is SpeedExerciseDefinition;
    private bool IsFingerIndependence => RuntimeExercise.Definition is FingerIndependenceExerciseDefinition;
    private bool IsAuthoredSequence => RuntimeExercise.Definition is SequenceExerciseDefinition;
    private SpeedChallengeDetails SpeedDetails => RuntimeExercise.Challenge.Speed!;
    private FingerIndependenceChallengeDetails FingerDetails => RuntimeExercise.Challenge.FingerIndependence!;
    private SequenceExerciseDefinition? SequenceDefinition => RuntimeExercise.Definition as SequenceExerciseDefinition;
    private ScaleConfiguration? ActiveScale => SequenceDefinition?.Scale;
    private bool HasSelectableScaleHand => ActiveScale is { Type: ScaleType.Major, Root: "C4", Octaves: 1, Direction: ScaleDirection.Ascending or ScaleDirection.Descending } && StepCount == 8;
    private string ScaleLabel => ActiveScale is { } scale
        ? $"{scale.Root} {UiText.GetScaleType(scale.Type)}"
        : UiText.ScalePractice;
    private IReadOnlyList<string> ExpectedNotes => IsSpeed ? SpeedDetails.ExpectedNotes :
        IsFingerIndependence ? FingerDetails.ExpectedNotes : RuntimeExercise.Challenge.Sequence!.ExpectedNotes;
    private OrderedNoteProgress? _orderedNoteProgress;
    private int ProgressIndex => IsAuthoredSequence ? _orderedNoteProgress!.CompletedCount : _stepIndex;
    private int StepCount => ExpectedNotes.Count;
    private int CurrentStep => Math.Min(ProgressIndex + 1, StepCount);
    private int CompletedStepCount => Math.Min(ProgressIndex, StepCount);
    private int ProgressPercent => (int)Math.Round(CompletedStepCount * 100d / StepCount);
    private string PracticeLabel => IsSpeed ? UiText.SpeedPractice : IsFingerIndependence
        ? UiText.FingerIndependencePractice : ActiveScale is not null ? UiText.ScalePractice : UiText.SequencePractice;
    private string Instruction => IsSpeed ? UiText.PlayTheSequenceInTime : IsFingerIndependence
        ? UiText.PlayTheFingerSequence : RuntimeExercise.Definition.Title;
    private string Description => IsSpeed ? UiText.SpeedPracticeInstructions : IsFingerIndependence
        ? UiText.FingerIndependenceInstructions : string.IsNullOrWhiteSpace(RuntimeExercise.Definition.Description)
            ? UiText.ScalePracticeInstructions
            : RuntimeExercise.Definition.Description;
    private string FingerList => string.Join(UiText.ListSeparator, FingerDetails.Fingers.Select(UiText.FormatNumber));
    private IReadOnlyList<int> SuggestedFingers
    {
        get
        {
            if (!HasSelectableScaleHand) return [];
            var scaleDetails = RuntimeExercise.Challenge.Sequence!;
            return _selectedScaleHand == scaleDetails.Hand && scaleDetails.Fingers.Count == StepCount
                ? scaleDetails.Fingers
                : ScaleFingeringGuide.GetFingers(_selectedScaleHand, ActiveScale!.Direction);
        }
    }
    private MusicalNote FirstPianoNote => MusicalNote.Parse("C4");
    private MusicalNote LastPianoNote => MusicalNote.Parse("C5");
    protected override void OnInitialized()
    {
        if (IsAuthoredSequence) _selectedScaleHand = RuntimeExercise.Challenge.Sequence!.Hand is PracticeHand.Left or PracticeHand.Right
            ? RuntimeExercise.Challenge.Sequence.Hand
            : PracticeHand.Right;
        if (IsAuthoredSequence) _orderedNoteProgress = new OrderedNoteProgress(ExpectedNotes);
        _midiRegistration = MidiInput.Register(HandleMidiMessageAsync);
        MidiInput.SelectedDeviceStateChanged += HandleMidiDeviceStateChanged;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await CaptureBrowserTimelineOriginAsync();
    }
    private async Task CaptureBrowserTimelineOriginAsync()
    {
        _browserTimelineOriginMilliseconds = await MidiInput.CaptureBrowserTimestampAsync();
        MidiInput.SetTimelineOrigin(_browserTimelineOriginMilliseconds);
    }
    private Task HandleTempoChanged(int _) => InvokeAsync(StateHasChanged);
    private Task HandleScaleHandChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse<PracticeHand>(args.Value?.ToString(), out var hand) && hand is PracticeHand.Left or PracticeHand.Right)
        {
            _selectedScaleHand = hand;
        }
        return InvokeAsync(StateHasChanged);
    }
    private int GetSuggestedFinger(int index) => SuggestedFingers[index];
    private string GetLiveFeedback() => _lastInputCorrect == true
        ? UiText.InputAccepted
        : IsAuthoredSequence
            ? _lastInputOctaveMismatch ? UiText.OctaveMismatchTryAgain : UiText.TryExpectedNoteAgain
            : UiText.InputIncorrect;
    private Task HandleMetronomeRunningChanged(bool isRunning) { _metronomeRunning = isRunning; return InvokeAsync(StateHasChanged); }
    private async Task StartSequenceAsync()
    {
        if (_isActive || _completed) return;
        if (_pausedForMidi)
        {
            RuntimeExercise.ResetCapturedInputs();
            _orderedNoteProgress?.Reset();
            _stepIndex = 0;
            _lastSelectedNote = null;
        }
        _pausedForMidi = false;
        await CaptureBrowserTimelineOriginAsync();
        _timelineStartedAt = DateTime.UtcNow;
        _isActive = true;
        _lastInputCorrect = null;
        await InvokeAsync(StateHasChanged);
    }
    private Task HandlePianoNote(MusicalNote note) => CaptureInputAsync(VirtualPianoInputAdapter.Create(note, RuntimeExercise.StartedAt, DateTime.UtcNow, _timelineStartedAt));
    private Task HandleKeyDown(KeyboardEventArgs args)
    {
        var input = NoteReadingKeyboardInputAdapter.TryCreate(args.Code, args.Repeat, _isActive, RuntimeExercise.StartedAt, DateTime.UtcNow, _timelineStartedAt);
        return input is null ? Task.CompletedTask : CaptureInputAsync(input);
    }
    private Task HandleMidiMessageAsync(MidiInputMessage message)
    {
        var input = _browserTimelineOriginMilliseconds is { } origin
            ? MidiInputAdapter.TryCreate(message, DateTime.UtcNow, origin)
            : null;
        if (!_isActive || _completed || input is null) return Task.CompletedTask;
        RuntimeExercise.CaptureMidiEvent(input);
        if (input.Type != InputEventType.Note)
        {
            return Task.CompletedTask;
        }
        return CaptureInputAsync(input);
    }
    private void HandleMidiDeviceStateChanged(string? deviceId, bool connected)
    {
        if (connected || !_isActive) return;
        _isActive = false;
        _pausedForMidi = true;
        _stepIndex = 0;
        _orderedNoteProgress?.Reset();
        _lastSelectedNote = null;
        RuntimeExercise.ResetCapturedInputs();
        MidiInput.SetTimelineOrigin(null);
        _ = InvokeAsync(StateHasChanged);
    }
    private async Task CaptureInputAsync(ExerciseInputEvent input)
    {
        if (!_isActive || _completed) return;
        _lastSelectedNote = MusicalNote.Parse(input.Value);
        if (IsAuthoredSequence)
        {
            var expectedNote = _orderedNoteProgress!.CurrentExpectedNote!;
            _lastInputCorrect = _orderedNoteProgress!.TryAccept(input.Value);
            _lastInputOctaveMismatch = !_lastInputCorrect.Value && IsOctaveMismatch(input.Value, expectedNote);
            if (!_lastInputCorrect.Value) return;

            RuntimeExercise.CaptureInput(input);
            if (_orderedNoteProgress.IsComplete)
            {
                _isActive = false;
                _completed = true;
                await OnCompleted.InvokeAsync(DateTime.UtcNow);
            }
            return;
        }

        var expected = RuntimeExercise.Challenge.ExpectedInputs[_stepIndex];
        _lastInputCorrect = string.Equals(expected.Value, input.Value, StringComparison.OrdinalIgnoreCase);
        RuntimeExercise.CaptureInput(input);
        _stepIndex++;
        if (_stepIndex == StepCount) { _isActive = false; _completed = true; await OnCompleted.InvokeAsync(DateTime.UtcNow); }
    }
    private static bool IsOctaveMismatch(string actual, string expected) =>
        MusicalNote.TryParse(actual, out var actualNote) && MusicalNote.TryParse(expected, out var expectedNote) &&
        string.Equals(actualNote.Name, expectedNote.Name, StringComparison.OrdinalIgnoreCase) && actualNote.Octave != expectedNote.Octave;
    private Task RestartScalePractice()
    {
        RuntimeExercise.ResetCapturedInputs();
        _orderedNoteProgress?.Reset();
        _stepIndex = 0;
        _isActive = false;
        _completed = false;
        _pausedForMidi = false;
        _lastInputCorrect = null;
        _lastInputOctaveMismatch = false;
        _lastSelectedNote = null;
        MidiInput.SetTimelineOrigin(null);
        return InvokeAsync(StateHasChanged);
    }
    private string GetStepClass(int index) => index < ProgressIndex ? "is-complete" : _isActive && index == ProgressIndex ? "is-active" : string.Empty;
    public void Dispose()
    {
        MidiInput.SelectedDeviceStateChanged -= HandleMidiDeviceStateChanged;
        _midiRegistration?.Dispose();
    }
}
