@namespace KeyForge.Components.Practice
@implements IAsyncDisposable
@inject IJSRuntime JavaScript
@inject MidiInputRouter InputRouter
@inject MidiPracticeInputState MidiState

<section class="midi-input-control" aria-label="@UiText.Midi">
    <div class="midi-input-control__header">
        <div>
            <p class="kf-meta">@UiText.Midi</p>
            <p class="kf-text-secondary">@StatusLabel</p>
        </div>
        @if (!_enabled && _status is not MidiInputStatus.Unsupported)
        {
            <button class="kf-button kf-button--secondary" type="button" @onclick="EnableAsync">@UiText.EnableMidi</button>
        }
    </div>

    @if (_enabled && _devices.Count > 0)
    {
        <label class="midi-input-control__selector">
            <span class="kf-meta">@UiText.MidiDevice</span>
            <select value="@_selectedDeviceId" @onchange="SelectDeviceAsync" aria-label="@UiText.MidiDevice">
                @foreach (var device in _devices)
                {
                    <option value="@device.Id">@device.DisplayName</option>
                }
            </select>
        </label>
    }

    @if (_status is MidiInputStatus.Connected)
    {
        <dl class="midi-input-control__diagnostics" aria-live="polite">
            <div><dt>@UiText.SelectedMidiDevice</dt><dd>@SelectedDeviceName</dd></div>
            <div><dt>@UiText.MidiInputStatus</dt><dd>@UiText.MidiInputActive</dd></div>
            <div><dt>@UiText.LastMidiNote</dt><dd><bdi>@(MidiState.LastNote?.Value ?? UiText.NoMidiActivity)</bdi></dd></div>
            <div><dt>@UiText.Velocity</dt><dd>@VelocityLabel</dd></div>
            <div><dt>@UiText.Sustain</dt><dd>@(MidiState.IsSustainDown ? UiText.PedalDown : UiText.PedalUp)</dd></div>
        </dl>
    }

    @if (_status is MidiInputStatus.PermissionDenied or MidiInputStatus.Error)
    {
        <p class="midi-input-control__error" role="alert">@StatusLabel</p>
    }
</section>

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<MidiInputControl>? _dotNetReference;
    private IReadOnlyList<MidiDeviceDescriptor> _devices = [];
    private string? _selectedDeviceId;
    private MidiInputStatus _status = MidiInputStatus.Disabled;
    private bool _enabled;

    private string StatusLabel => _status switch
    {
        MidiInputStatus.Unsupported => UiText.MidiNotSupported,
        MidiInputStatus.PermissionDenied => UiText.MidiPermissionDenied,
        MidiInputStatus.NoDevice => UiText.MidiNoDevice,
        MidiInputStatus.Connected => UiText.MidiConnected,
        MidiInputStatus.Error => UiText.MidiConnectionError,
        _ => UiText.MidiDisabled
    };
    private string SelectedDeviceName => _devices.FirstOrDefault(device => device.Id == _selectedDeviceId)?.DisplayName ?? UiText.MidiNoDevice;
    private string VelocityLabel => MidiState.LastVelocity is { } velocity
        ? $"{UiText.GetMidiVelocityLevel(MidiPracticeInputState.GetVelocityLevel(velocity))} ({velocity})"
        : UiText.NoMidiActivity;

    protected override void OnInitialized() => MidiState.Changed += HandleMidiStateChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./Components/Practice/MidiInputControl.razor.js");
            var supported = await _module.InvokeAsync<bool>("isSupported");
            if (!supported)
            {
                _status = MidiInputStatus.Unsupported;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (JSException)
        {
            _status = MidiInputStatus.Error;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task EnableAsync()
    {
        if (_module is null)
        {
            _status = MidiInputStatus.Error;
            return;
        }

        try
        {
            _dotNetReference ??= DotNetObjectReference.Create(this);
            var state = await _module.InvokeAsync<MidiAccessState>("enable", _dotNetReference);
            ApplyState(state);
        }
        catch (JSException)
        {
            _status = MidiInputStatus.Error;
        }
    }

    private async Task SelectDeviceAsync(ChangeEventArgs args)
    {
        if (_module is null || args.Value is not string deviceId)
        {
            return;
        }

        try
        {
            ApplyState(await _module.InvokeAsync<MidiAccessState>("selectInput", deviceId));
        }
        catch (JSException)
        {
            _status = MidiInputStatus.Error;
        }
    }

    [JSInvokable]
    public async Task HandleMidiMessage(MidiInputMessage message)
    {
        var presentationEvent = MidiInputAdapter.TryCreatePresentationEvent(message);
        if (presentationEvent is not null)
        {
            MidiState.Apply(presentationEvent);
        }

        if (MidiInputAdapter.IsNoteOn(message))
        {
            await InputRouter.DispatchAsync(message);
        }
    }

    [JSInvokable]
    public Task HandleMidiDevicesChanged(MidiAccessState state)
    {
        ApplyState(state);
        return InvokeAsync(StateHasChanged);
    }

    private void ApplyState(MidiAccessState state)
    {
        if (!string.Equals(_selectedDeviceId, state.SelectedDeviceId, StringComparison.Ordinal))
        {
            MidiState.Reset();
        }
        _enabled = state.Enabled;
        _devices = state.Devices ?? [];
        _selectedDeviceId = state.SelectedDeviceId;
        _status = state.Status;
    }

    private void HandleMidiStateChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        MidiState.Changed -= HandleMidiStateChanged;
        MidiState.Reset();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Browser resources are released with the disconnected circuit.
            }
        }

        _dotNetReference?.Dispose();
    }
}
