@namespace KeyForge.Components.Practice
@using KeyForge.Components.Audio
@implements IAsyncDisposable
@inject IJSRuntime JavaScript
@inject MidiInputRouter InputRouter
@inject MidiPracticeInputState MidiState

<section class="midi-input-control" aria-label="@UiText.Midi">
    <div class="midi-input-control__header">
        <div>
            <p class="kf-meta">@UiText.Midi</p>
            <p class="kf-text-secondary">@StatusLabel</p>
        </div>
        @if (!_enabled && _status is not MidiInputStatus.Unsupported)
        {
            <button class="kf-button kf-button--secondary" type="button" @onclick="EnableAsync">@UiText.EnableMidi</button>
        }
    </div>

    @if (_enabled && _devices.Count > 0)
    {
        <label class="midi-input-control__selector">
            <span class="kf-meta">@UiText.MidiDevice</span>
            <select value="@SelectedInputValue" @onchange="SelectDeviceAsync" aria-label="@UiText.MidiDevice">
                @if (_selectedDeviceId is null)
                {
                    <option value="" disabled>@UiText.MidiSelectDevice</option>
                }
                else if (_devices.All(device => device.Id != _selectedDeviceId))
                {
                    <option value="__selected-unavailable" disabled>@SelectedDeviceName (@StatusLabel)</option>
                }
                @foreach (var device in _devices)
                {
                    <option value="@device.Id">@device.DisplayName</option>
                }
            </select>
        </label>
    }

    @if (_selectedDeviceId is not null)
    {
        <dl class="midi-input-control__diagnostics" aria-live="polite">
            <div><dt>@UiText.SelectedMidiDevice</dt><dd>@SelectedDeviceName</dd></div>
            <div><dt>@UiText.MidiInputStatus</dt><dd>@StatusLabel</dd></div>
            @if (_status is MidiInputStatus.Connected)
            {
                <div><dt>@UiText.DeviceManufacturer</dt><dd>@(_selectedDeviceManufacturer ?? UiText.NoMidiActivity)</dd></div>
                <div><dt>@UiText.LastMidiNote</dt><dd><bdi>@(MidiState.LastNote?.Value ?? UiText.NoMidiActivity)</bdi></dd></div>
                <div><dt>@UiText.Velocity</dt><dd>@VelocityLabel</dd></div>
                <div><dt>@UiText.MidiChannel</dt><dd>@(_lastChannel is { } channel ? UiText.FormatNumber(channel) : UiText.NoMidiActivity)</dd></div>
                <div><dt>@UiText.LastMidiEvent</dt><dd>@(_lastEvent ?? UiText.NoMidiActivity)</dd></div>
                <div><dt>@UiText.Sustain</dt><dd>@(MidiState.IsSustainDown ? UiText.PedalDown : UiText.PedalUp)</dd></div>
            }
        </dl>
    }

    @if (_status is MidiInputStatus.PermissionDenied or MidiInputStatus.Error or MidiInputStatus.DeviceOpenFailure)
    {
        <p class="midi-input-control__error" role="alert">@StatusLabel @(_errorMessage)</p>
    }
</section>

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<MidiInputControl>? _dotNetReference;
    private IReadOnlyList<MidiDeviceDescriptor> _devices = [];
    private string? _selectedDeviceId;
    private string? _selectedDeviceName;
    private string? _selectedDeviceManufacturer;
    private string? _errorMessage;
    private int? _lastChannel;
    private string? _lastEvent;
    private bool? _configuredLivePlay;
    private string? _configuredPresetId;
    private MidiInputStatus _status = MidiInputStatus.Disabled;
    private bool _enabled;
    private IDisposable? _browserClockRegistration;

    [Parameter]
    public bool LivePlayEnabled { get; set; }

    [Parameter]
    public InstrumentPreset? LivePracticeSound { get; set; }

    private string StatusLabel => _status switch
    {
        MidiInputStatus.Unsupported => UiText.MidiNotSupported,
        MidiInputStatus.PermissionDenied => UiText.MidiPermissionDenied,
        MidiInputStatus.NoDevice => UiText.MidiNoDevice,
        MidiInputStatus.Connected => UiText.MidiConnected,
        MidiInputStatus.DeviceDisconnected => UiText.MidiDeviceDisconnected,
        MidiInputStatus.DeviceOpenFailure => UiText.MidiDeviceOpenFailure,
        MidiInputStatus.DeviceSelectionRequired => UiText.MidiSelectDevice,
        MidiInputStatus.Error => UiText.MidiConnectionError,
        _ => UiText.MidiDisabled
    };
    private string SelectedDeviceName => _devices.FirstOrDefault(device => device.Id == _selectedDeviceId)?.DisplayName ??
        _selectedDeviceName ?? UiText.MidiNoDevice;
    private string SelectedInputValue => _selectedDeviceId is not null &&
        _devices.All(device => device.Id != _selectedDeviceId)
            ? "__selected-unavailable"
            : _selectedDeviceId ?? string.Empty;
    private string VelocityLabel => MidiState.LastVelocity is { } velocity
        ? $"{UiText.GetMidiVelocityLevel(MidiPracticeInputState.GetVelocityLevel(velocity))} ({velocity})"
        : UiText.NoMidiActivity;

    protected override void OnInitialized() => MidiState.Changed += HandleMidiStateChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./Components/Practice/MidiInputControl.razor.js");
                _browserClockRegistration = InputRouter.RegisterBrowserClock(async () =>
                    await _module.InvokeAsync<double>("getBrowserTimestamp"));
                var supported = await _module.InvokeAsync<bool>("isSupported");
                if (!supported) _status = MidiInputStatus.Unsupported;
                await InvokeAsync(StateHasChanged);
            }
            catch (JSException)
            {
                _status = MidiInputStatus.Error;
                await InvokeAsync(StateHasChanged);
            }
        }

        if (_module is not null && (_configuredLivePlay != LivePlayEnabled ||
            _configuredPresetId != LivePracticeSound?.Id))
        {
            try
            {
                await _module.InvokeVoidAsync("configureLivePlay", LivePlayEnabled, LivePracticeSound);
                _configuredLivePlay = LivePlayEnabled;
                _configuredPresetId = LivePracticeSound?.Id;
            }
            catch (JSException exception)
            {
                _errorMessage = exception.Message;
            }
        }
    }

    private async Task EnableAsync()
    {
        if (_module is null)
        {
            _status = MidiInputStatus.Error;
            return;
        }

        try
        {
            _dotNetReference ??= DotNetObjectReference.Create(this);
            var state = await _module.InvokeAsync<MidiAccessState>("enable", _dotNetReference);
            ApplyState(state);
        }
        catch (JSException exception)
        {
            _status = MidiInputStatus.Error;
            _errorMessage = exception.Message;
        }
    }

    private async Task SelectDeviceAsync(ChangeEventArgs args)
    {
        if (_module is null || args.Value is not string deviceId)
        {
            return;
        }

        try
        {
            ApplyState(await _module.InvokeAsync<MidiAccessState>("selectInput", deviceId));
        }
        catch (JSException exception)
        {
            _status = MidiInputStatus.Error;
            _errorMessage = exception.Message;
        }
    }

    [JSInvokable]
    public async Task HandleMidiMessage(MidiInputMessage message)
    {
        if (!InputRouter.Accepts(message)) return;
        _lastChannel = message.Channel;
        _lastEvent = (message.Status & 0xF0) switch
        {
            0x90 when message.Data2 > 0 => UiText.MidiNoteOn,
            0x80 or 0x90 => UiText.MidiNoteOff,
            0xB0 when message.Data1 == 64 => UiText.Sustain,
            0xB0 => UiText.MidiControlChange,
            0xE0 => UiText.MidiPitchBend,
            _ => UiText.MidiEvent
        };
        var presentationEvent = MidiInputAdapter.TryCreatePresentationEvent(message);
        if (presentationEvent is not null)
        {
            MidiState.Apply(presentationEvent);
        }

        await InputRouter.DispatchAsync(message);
    }

    [JSInvokable]
    public Task HandleMidiDevicesChanged(MidiAccessState state)
    {
        ApplyState(state);
        return InvokeAsync(StateHasChanged);
    }

    private void ApplyState(MidiAccessState state)
    {
        if (!string.Equals(_selectedDeviceId, state.SelectedDeviceId, StringComparison.Ordinal))
        {
            MidiState.Reset();
            _lastChannel = null;
            _lastEvent = null;
        }
        _enabled = state.Enabled;
        _devices = state.Devices ?? [];
        _selectedDeviceId = state.SelectedDeviceId;
        _selectedDeviceName = state.SelectedDeviceName is null ? null :
            string.IsNullOrWhiteSpace(state.SelectedDeviceManufacturer)
                ? state.SelectedDeviceName
                : $"{state.SelectedDeviceManufacturer} {state.SelectedDeviceName}";
        _selectedDeviceManufacturer = state.SelectedDeviceManufacturer;
        _errorMessage = state.ErrorMessage;
        _status = state.Status;
        InputRouter.SetSelectedDevice(state.SelectedDeviceId, state.Status is MidiInputStatus.Connected);
        if (state.Status is MidiInputStatus.DeviceDisconnected or MidiInputStatus.NoDevice or MidiInputStatus.Error)
        {
            MidiState.Reset();
        }
    }

    private void HandleMidiStateChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        MidiState.Changed -= HandleMidiStateChanged;
        _browserClockRegistration?.Dispose();
        InputRouter.SetSelectedDevice(null, false);
        MidiState.Reset();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("configureLivePlay", false, null);
                await _module.InvokeVoidAsync("dispose");
            }
            catch (JSDisconnectedException)
            {
                // Browser resources are released with the disconnected circuit.
            }
            catch (JSException)
            {
                // Cleanup must not interrupt navigation if the MIDI adapter is already gone.
            }

            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser already reclaimed the module reference.
            }
            catch (JSException)
            {
                // Cleanup must not interrupt navigation if the module was already released.
            }
        }

        _dotNetReference?.Dispose();
    }
}
