@using KeyForge.Components.Audio
@using KeyForge.Features.Practice.Models
@implements IAsyncDisposable
@inject IAudioPlaybackService Audio

@if (IsEnabled)
{
    <section class="metronome-control" aria-labelledby="@($"{_id}-title")">
        <div class="metronome-control__header">
            <div>
                <p class="kf-meta">@UiText.Metronome</p>
                <h3 id="@($"{_id}-title")" class="kf-card__title"><bdi>@UiText.GetBpmLabel(CurrentBpm)</bdi></h3>
            </div>
            <span class="kf-status-badge kf-status-badge--available">@StatusLabel</span>
        </div>

        @if (ActiveConfiguration.Visual)
        {
            <div class="metronome-control__visual" aria-live="polite" aria-label="@UiText.MetronomeBeat">
                @for (var beat = 1; beat <= VisualBeatCount; beat++)
                {
                    <span class="@(_currentBeat == beat ? "is-active" : null)"></span>
                }
                <strong>@(IsCountingIn ? UiText.GetCountInLabel(_currentBeat) : UiText.GetBeatLabel(_currentBeat))</strong>
            </div>
        }

        @if (_audioFailed)
        {
            <p class="metronome-control__error" role="status">@UiText.AudioUnavailable</p>
        }

        <div class="metronome-control__actions">
            @if (!_isRunning)
            {
                <button class="kf-button kf-button--primary" type="button" @ref="_startButton" @onclick="StartAsync">@UiText.StartMetronome</button>
            }
            else
            {
                <button class="kf-button kf-button--secondary" type="button" @onclick="StopAsync">@UiText.StopMetronome</button>
            }
        </div>
    </section>
}

@code {
    [Parameter]
    public RuntimeExercise? RuntimeExercise { get; set; }

    [Parameter]
    public MetronomeConfiguration? Configuration { get; set; }

    [Parameter]
    public int? StandaloneBpm { get; set; }

    [Parameter]
    public bool StopAfterCountIn { get; set; }

    [Parameter]
    public EventCallback OnCountInCompleted { get; set; }

    [Parameter]
    public EventCallback<bool> OnRunningChanged { get; set; }

    private readonly string _id = $"metronome-{Guid.NewGuid():N}";
    private CancellationTokenSource? _runCancellation;
    private bool _isRunning;
    private bool _audioFailed;
    private int _currentBeat;
    private ElementReference _startButton;
    private bool _activationPrepared;
    private bool _disposed;
    private bool _countInCompleted;

    private MetronomeConfiguration ActiveConfiguration => Configuration ?? new MetronomeConfiguration
        { Enabled = true, Audio = true, Visual = false };
    private bool IsEnabled => Configuration?.Enabled == true || StandaloneBpm is not null;
    private int CurrentBpm => StandaloneBpm ?? RuntimeExercise?.SelectedBpm ?? RuntimeExercise?.Definition.Tempo?.DefaultBpm ?? 0;
    private int VisualBeatCount => Math.Max(ActiveConfiguration.CountInBeats, 4);
    private bool IsCountingIn => _isRunning && !_countInCompleted;
    private string StatusLabel => !_isRunning ? UiText.MetronomeReady : IsCountingIn ? UiText.CountingIn : UiText.MetronomeActive;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsEnabled && !_isRunning && !_activationPrepared && ActiveConfiguration.Audio)
        {
            _activationPrepared = true;
            await Audio.PrepareActivationAsync(_startButton);
        }
    }

    private async Task StartAsync()
    {
        if (_disposed || _isRunning || CurrentBpm <= 0)
        {
            return;
        }

        _isRunning = true;
        _audioFailed = false;
        _countInCompleted = ActiveConfiguration.CountInBeats == 0;
        if (ActiveConfiguration.Audio && !await Audio.InitializeAsync())
        {
            _audioFailed = true;
        }

        if (_disposed) return;

        _runCancellation = new CancellationTokenSource();
        _currentBeat = 0;
        await OnRunningChanged.InvokeAsync(true);
        _ = RunAsync(_runCancellation.Token);
    }

    private async Task RunAsync(CancellationToken cancellationToken)
    {
        try
        {
            var interval = MetronomeTiming.GetBeatInterval(CurrentBpm);
            foreach (var beat in MetronomeTiming.GetCountInBeats(ActiveConfiguration.CountInBeats))
            {
                await TickAsync(beat, cancellationToken);
                await Task.Delay(interval, cancellationToken);
            }

            cancellationToken.ThrowIfCancellationRequested();
            _countInCompleted = true;
            await OnCountInCompleted.InvokeAsync();
            if (StopAfterCountIn)
            {
                await StopAsync();
                return;
            }

            for (var beat = 1; ; beat = beat == VisualBeatCount ? 1 : beat + 1)
            {
                await TickAsync(beat, cancellationToken);
                await Task.Delay(interval, cancellationToken);
            }
        }
        catch (OperationCanceledException)
        {
            // Stop, navigation, and disposal deliberately cancel this loop.
        }
    }

    private async Task TickAsync(int beat, CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();
        _currentBeat = beat;
        await InvokeAsync(StateHasChanged);
        if (ActiveConfiguration.Audio && !_audioFailed && !await Audio.PlayMetronomeClickAsync())
        {
            _audioFailed = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopAsync()
    {
        _runCancellation?.Cancel();
        _runCancellation?.Dispose();
        _runCancellation = null;
        if (!_isRunning)
        {
            return;
        }

        _isRunning = false;
        _activationPrepared = false;
        _currentBeat = 0;
        await Audio.StopActiveNotesAsync();
        if (!_disposed) await OnRunningChanged.InvokeAsync(false);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await StopAsync();
    }
}
