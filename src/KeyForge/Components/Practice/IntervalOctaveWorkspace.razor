@namespace KeyForge.Components.Practice
@implements IDisposable
@inject MidiInputRouter MidiInput

<div class="kf-practice-workspace note-reading-workspace"
     tabindex="0"
     @onkeydown="HandleKeyDown"
     aria-labelledby="note-target-title">
    <header class="kf-practice-workspace__header note-reading-workspace__header">
        <div>
            <p class="kf-meta">@PracticeLabel</p>
            <h2 id="note-target-title" class="kf-card__title">@Instruction</h2>
            <p class="kf-card__description">@UiText.PlayTheTargetNote</p>
        </div>
        <span class="kf-status-badge kf-status-badge--available">
            @UiText.GetQuestionPosition(CurrentQuestionNumber, QuestionCount)
        </span>
    </header>

    <div class="kf-practice-workspace__progress note-reading-workspace__progress">
        <span class="kf-meta">@UiText.QuestionProgress</span>
        <div class="kf-progress" role="progressbar" aria-label="@UiText.QuestionProgress"
             aria-valuemin="0" aria-valuemax="@QuestionCount" aria-valuenow="@CurrentQuestionNumber">
            <div class="kf-progress__value" style="@($"--kf-progress-value: {QuestionProgressPercent}%")"></div>
        </div>
    </div>

    <div class="interval-octave-workspace__source">
        <p class="kf-meta">@UiText.SourceNote</p>
        <MusicStaff Note="CurrentSourceNote" Clef="CurrentClef" />
    </div>

    <section class="kf-practice-input note-reading-workspace__piano" aria-labelledby="piano-title">
        <div class="kf-practice-input__header note-reading-workspace__piano-header">
            <div>
                <h3 id="piano-title" class="kf-section-title">@UiText.VirtualPiano</h3>
                <p class="kf-text-secondary">@UiText.SelectPianoNote</p>
            </div>
            <p class="kf-meta">@UiText.ComputerKeyboardHint</p>
        </div>
        <PianoKeyboard FirstNote="FirstPianoNote"
                       LastNote="LastPianoNote"
                       SelectedNote="_selectedNote"
                       ExpectedNote="CurrentTargetNote"
                       RevealAnswer="IsAnswered"
                       Disabled="IsAnswered"
                       OnNoteSelected="HandlePianoNote" />
    </section>

    @if (IsAnswered)
    {
        <section class="kf-practice-feedback @FeedbackClass" role="status" aria-live="polite">
            <div>
                <p class="kf-meta">@UiText.AttemptResult</p>
                <h3 class="kf-section-title">@(IsCurrentAnswerCorrect ? UiText.CorrectAnswer : UiText.IncorrectAnswer)</h3>
            </div>
            <dl class="kf-practice-feedback__values note-reading-feedback__values">
                <div><dt>@UiText.SourceNote</dt><dd><bdi>@CurrentSourceNote.Value</bdi></dd></div>
                <div><dt>@RelationshipLabel</dt><dd><bdi>@RelationshipValue</bdi></dd></div>
                <div><dt>@UiText.ExpectedNote</dt><dd><bdi>@CurrentTargetNote.Value</bdi></dd></div>
                <div><dt>@UiText.YourNote</dt><dd><bdi>@_selectedNote?.Value</bdi></dd></div>
            </dl>
            <div class="kf-practice-feedback__actions note-reading-feedback__actions">
                @if (!IsCurrentAnswerCorrect)
                {
                    <button class="kf-button kf-button--secondary" type="button" @onclick="RetryQuestion">@UiText.RetryQuestion</button>
                }
                <button class="kf-button kf-button--primary" type="button" @onclick="AcceptAnswer">@UiText.ContinueQuestions</button>
            </div>
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public RuntimeExercise RuntimeExercise { get; set; } = null!;
    [Parameter] public EventCallback<DateTime> OnCompleted { get; set; }

    private int _questionIndex;
    private ExerciseInputEvent? _pendingInput;
    private MusicalNote? _selectedNote;
    private double? _browserTimelineOriginMilliseconds;
    private IDisposable? _midiRegistration;

    private bool IsInterval => RuntimeExercise.Definition is IntervalExerciseDefinition;
    private int QuestionCount => RuntimeExercise.Challenge.ExpectedInputs.Count;
    private int CurrentQuestionNumber => _questionIndex + 1;
    private ExpectedInput CurrentExpectedInput => RuntimeExercise.Challenge.ExpectedInputs[_questionIndex];
    private MusicalNote CurrentTargetNote => MusicalNote.Parse(CurrentExpectedInput.Value);
    private MusicalNote CurrentSourceNote => MusicalNote.Parse(IsInterval
        ? RuntimeExercise.Challenge.Interval!.Questions[_questionIndex].SourceNote
        : RuntimeExercise.Challenge.Octave!.Questions[_questionIndex].SourceNote);
    private ExerciseDirection CurrentDirection => IsInterval
        ? RuntimeExercise.Challenge.Interval!.Questions[_questionIndex].Direction
        : RuntimeExercise.Challenge.Octave!.Questions[_questionIndex].Direction;
    private string PracticeLabel => IsInterval ? UiText.IntervalPractice : UiText.OctavePractice;
    private string Instruction => IsInterval
        ? UiText.GetIntervalInstruction(RuntimeExercise.Challenge.Interval!.Questions[_questionIndex].Interval, CurrentDirection)
        : UiText.GetOctaveInstruction(RuntimeExercise.Challenge.Octave!.Questions[_questionIndex].Octaves, CurrentDirection);
    private string RelationshipLabel => IsInterval ? UiText.TargetInterval : UiText.TargetOctaves;
    private string RelationshipValue => IsInterval
        ? RuntimeExercise.Challenge.Interval!.Questions[_questionIndex].Interval
        : UiText.FormatNumber(RuntimeExercise.Challenge.Octave!.Questions[_questionIndex].Octaves);
    private bool IsAnswered => _pendingInput is not null;
    private bool IsCurrentAnswerCorrect => _pendingInput is not null &&
        NoteTargetExerciseEvaluator.IsCorrect(CurrentExpectedInput, _pendingInput);
    private int QuestionProgressPercent => (int)Math.Round(CurrentQuestionNumber * 100d / QuestionCount);
    private ClefType CurrentClef => CurrentSourceNote.MidiNumber < MusicalNote.Parse("C4").MidiNumber
        ? ClefType.Bass : ClefType.Treble;
    private MusicalNote FirstPianoNote => MusicalNote.FromMidiNumber(Math.Max(0,
        Math.Min(CurrentSourceNote.MidiNumber, CurrentTargetNote.MidiNumber) - 5));
    private MusicalNote LastPianoNote => MusicalNote.FromMidiNumber(Math.Min(127,
        Math.Max(CurrentSourceNote.MidiNumber, CurrentTargetNote.MidiNumber) + 5));
    private string FeedbackClass => IsCurrentAnswerCorrect
        ? "note-reading-feedback note-reading-feedback--correct"
        : "note-reading-feedback note-reading-feedback--incorrect";

    protected override void OnInitialized() => _midiRegistration = MidiInput.Register(HandleMidiMessageAsync);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _browserTimelineOriginMilliseconds = await MidiInput.CaptureBrowserTimestampAsync();
            MidiInput.SetTimelineOrigin(_browserTimelineOriginMilliseconds);
        }
    }

    private void HandlePianoNote(MusicalNote note)
    {
        if (!IsAnswered)
        {
            SetPendingInput(VirtualPianoInputAdapter.Create(note, RuntimeExercise.StartedAt, DateTime.UtcNow));
        }
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        var input = NoteReadingKeyboardInputAdapter.TryCreate(args.Code, args.Repeat, !IsAnswered,
            RuntimeExercise.StartedAt, DateTime.UtcNow);
        if (input is not null)
        {
            SetPendingInput(input);
        }
    }

    private void SetPendingInput(ExerciseInputEvent input)
    {
        _pendingInput = input;
        _selectedNote = MusicalNote.Parse(input.Value);
    }

    private Task HandleMidiMessageAsync(MidiInputMessage message)
    {
        var input = _browserTimelineOriginMilliseconds is { } origin
            ? MidiInputAdapter.TryCreate(message, DateTime.UtcNow, origin)
            : null;
        if (input is null) return Task.CompletedTask;
        RuntimeExercise.CaptureMidiEvent(input);
        if (!IsAnswered && input.Type == InputEventType.Note) SetPendingInput(input);
        return Task.CompletedTask;
    }

    private void RetryQuestion()
    {
        _pendingInput = null;
        _selectedNote = null;
    }

    private async Task AcceptAnswer()
    {
        if (_pendingInput is null) return;
        RuntimeExercise.CaptureInput(_pendingInput);
        if (_questionIndex == QuestionCount - 1)
        {
            await OnCompleted.InvokeAsync(DateTime.UtcNow);
            return;
        }
        _questionIndex++;
        _pendingInput = null;
        _selectedNote = null;
    }

    public void Dispose() => _midiRegistration?.Dispose();
}
