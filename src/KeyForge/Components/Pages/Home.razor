@page "/"

<PageTitle>@UiText.Home - @UiText.ProductName</PageTitle>

<header class="kf-page-header">
    <div>
        <p class="kf-meta">@UiText.HomeEyebrow</p>
        <h1 class="kf-page-title">@UiText.HomeTitle</h1>
        <p class="kf-page-header__description">@UiText.HomeDescription</p>
    </div>
    <a class="kf-button kf-button--primary" href="/lessons">@UiText.BrowseLessons</a>
</header>

<section aria-labelledby="home-highlights-title">
    <h2 id="home-highlights-title" class="kf-section-title">@UiText.HomeHighlightsTitle</h2>
    <div class="kf-card-grid">
        <article class="kf-card">
            <div class="kf-card__body">
                <h3 class="kf-card__title">@UiText.HomeHighlightLessonsTitle</h3>
                <p class="kf-card__description">@UiText.HomeHighlightLessonsDescription</p>
            </div>
        </article>
        <article class="kf-card">
            <div class="kf-card__body">
                <h3 class="kf-card__title">@UiText.HomeHighlightPracticeTitle</h3>
                <p class="kf-card__description">@UiText.HomeHighlightPracticeDescription</p>
            </div>
        </article>
        <article class="kf-card">
            <div class="kf-card__body">
                <h3 class="kf-card__title">@UiText.HomeHighlightProgressTitle</h3>
                <p class="kf-card__description">@UiText.HomeHighlightProgressDescription</p>
            </div>
        </article>
    </div>
</section>
