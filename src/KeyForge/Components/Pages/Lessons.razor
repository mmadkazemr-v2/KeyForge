@page "/lessons"
@using KeyForge.Features.Lessons.Models
@using KeyForge.Features.Lessons.Services
@inject ILessonProgressQueryService LessonQuery

<PageTitle>@UiText.Lessons - @UiText.ProductName</PageTitle>

<header class="kf-page-header">
    <div>
        <p class="kf-meta">@UiText.LearningPath</p>
        <h1 id="lesson-catalog-title" class="kf-page-title">@UiText.Lessons</h1>
        <p class="kf-page-header__description">@UiText.LessonsDescription</p>
    </div>
</header>

@if (_lessons.Count == 0)
{
    <section class="kf-card" role="status" aria-labelledby="empty-lessons-title">
        <div class="kf-card__body">
            <h2 id="empty-lessons-title" class="kf-card__title">@UiText.NoLessonsTitle</h2>
            <p class="kf-card__description kf-text-muted">@UiText.NoLessonsDescription</p>
        </div>
    </section>
}
else
{
    <section class="kf-card-grid" aria-labelledby="lesson-catalog-title">
        @foreach (var lesson in _lessons)
        {
            <article class="kf-card @GetCardStatusCssClass(lesson)"
                     aria-disabled="@GetAriaDisabled(lesson)">
                <div class="kf-card__body">
                    <div class="kf-card__header">
                        <h2 class="kf-card__title">@lesson.Title</h2>
                        <span class="kf-status-badge @GetStatusBadgeCssClass(lesson)">@GetStatusLabel(lesson)</span>
                    </div>

                    <p class="kf-card__description">@lesson.Description</p>
                </div>
                <ul class="kf-card__meta">
                    <li>@UiText.Level: @UiText.GetLessonLevel(lesson.Level)</li>
                    <li>@UiText.EstimatedTime: @lesson.EstimatedMinutes @UiText.Minute</li>
                    @if (lesson.BestScore is { } bestScore)
                    {
                        <li>@UiText.BestScore: <bdi>@bestScore%</bdi></li>
                    }
                    @if (CanOpenLesson(lesson))
                    {
                        <li>
                            <a class="kf-button kf-button--secondary"
                               href="@GetLessonUrl(lesson.Id)"
                               aria-label="@($"{UiText.ViewLesson}: {lesson.Title}")">
                                @UiText.ViewLesson
                            </a>
                        </li>
                    }
                </ul>
            </article>
        }
    </section>
}

@code {
    private IReadOnlyList<LessonListItem> _lessons = [];

    protected override void OnInitialized()
    {
        _lessons = LessonQuery.GetLessons();
    }

    private static string GetStatusLabel(LessonListItem lesson) =>
        UiText.GetLessonStatus(lesson.IsUnlocked, lesson.IsCompleted);

    private static string GetStatusBadgeCssClass(LessonListItem lesson) => lesson switch
    {
        { IsCompleted: true } => "kf-status-badge--completed",
        { IsUnlocked: true } => "kf-status-badge--available",
        _ => "kf-status-badge--locked"
    };

    private static string GetCardStatusCssClass(LessonListItem lesson) => lesson switch
    {
        { IsCompleted: true } => "kf-card--completed",
        { IsUnlocked: true } => "kf-card--available",
        _ => "kf-card--locked"
    };

    private static string? GetAriaDisabled(LessonListItem lesson) =>
        CanOpenLesson(lesson) ? null : "true";

    private static bool CanOpenLesson(LessonListItem lesson) =>
        lesson.IsUnlocked || lesson.IsCompleted;

    private static string GetLessonUrl(string lessonId) =>
        $"/lessons/{Uri.EscapeDataString(lessonId)}";
}
