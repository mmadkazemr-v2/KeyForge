@page "/practice/{LessonId}"
@rendermode InteractiveServer
@using KeyForge.Components.Audio
@using KeyForge.Components.Exercises
@using KeyForge.Components.Practice
@using KeyForge.Features.Exercises.Models
@using KeyForge.Features.Lessons.Models
@using KeyForge.Features.Lessons.Services
@using KeyForge.Features.Practice.Models
@using KeyForge.Features.Practice.Services
@using KeyForge.Features.Progress.Services
@inject IPracticeSessionService PracticeSessionService
@inject ILessonCatalog LessonCatalog
@inject ILessonProgressQueryService LessonQuery
@inject IProgressUpdateService ProgressUpdateService

<PageTitle>@(_lesson is null ? UiText.PracticeSession : _lesson.Title) - @UiText.ProductName</PageTitle>

@if (_startState is PracticeStartState.NotFound)
{
    <header class="kf-page-header">
        <div>
            <p class="kf-meta">@UiText.PracticeSession</p>
            <h1 class="kf-page-title">@UiText.PracticeNotFound</h1>
            <p class="kf-page-header__description">@UiText.PracticeNotFoundDescription</p>
        </div>
        <a class="kf-button kf-button--secondary" href="@GetLibraryUrl()">@UiText.ReturnToLessons</a>
    </header>
}
else if (_startState is PracticeStartState.Locked)
{
    <header class="kf-page-header">
        <div>
            <p class="kf-meta">@UiText.PracticeSession</p>
            <h1 class="kf-page-title">@UiText.PracticeLocked</h1>
            <p class="kf-page-header__description">@UiText.PracticeLockedDescription</p>
        </div>
        <a class="kf-button kf-button--secondary" href="@GetLibraryUrl()">@UiText.ReturnToLessons</a>
    </header>
}
else if (_startState is PracticeStartState.Error)
{
    <header class="kf-page-header">
        <div>
            <p class="kf-meta">@UiText.PracticeSession</p>
            <h1 class="kf-page-title">@UiText.PracticeStartError</h1>
            <p class="kf-page-header__description">@UiText.PracticeStartErrorDescription</p>
        </div>
        <a class="kf-button kf-button--secondary" href="@GetLibraryUrl()">@UiText.ReturnToLessons</a>
    </header>
}
else if (_session?.IsFinished == true)
{
    <header class="kf-page-header">
        <div>
            <p class="kf-meta">@UiText.PracticeSession</p>
            <h1 class="kf-page-title">@UiText.SessionComplete</h1>
            <p class="kf-page-header__description">@UiText.SessionCompleteDescription</p>
        </div>
        <a class="kf-button kf-button--primary" href="@GetLibraryUrl()">@UiText.ReturnToLessons</a>
    </header>

    <section class="kf-card practice-completion" role="status" aria-labelledby="session-summary-title">
        <div class="kf-card__body">
            <div class="kf-card__header">
                <h2 id="session-summary-title" class="kf-card__title">@_lesson?.Title</h2>
                <span class="kf-status-badge @GetLessonCompletionBadgeClass()">@GetLessonCompletionLabel()</span>
            </div>
            <p class="kf-card__description">@UiText.LessonCompletionStatus: @GetLessonCompletionLabel()</p>
        </div>
        <ul class="kf-card__meta">
            @if (_lastResult is not null)
            {
                <li>@UiText.Score: <bdi>@_lastResult.Score%</bdi></li>
            }
            @if (_lessonState?.BestScore is { } bestScore)
            {
                <li>@UiText.BestScore: <bdi>@bestScore%</bdi></li>
            }
        </ul>
    </section>
}
else if (CurrentExercise is { } exercise)
{
    <header class="kf-page-header">
        <div>
            <p class="kf-meta">@UiText.PracticeSession</p>
            <h1 class="kf-page-title">@_lesson?.Title</h1>
            <p class="kf-page-header__description">@UiText.PracticeSessionDescription</p>
        </div>
        <a class="kf-button kf-button--secondary" href="@GetLibraryUrl()">@UiText.ReturnToLessons</a>
    </header>

    <div class="kf-content-stack practice-session">
        <section class="practice-progress" aria-labelledby="session-progress-label">
            <div class="practice-progress__header">
                <span id="session-progress-label" class="kf-meta">@UiText.SessionProgress</span>
                <span class="kf-text-secondary">@UiText.GetExercisePosition(CurrentExerciseNumber, _session!.Exercises.Count)</span>
            </div>
            <div class="kf-progress"
                 role="progressbar"
                 aria-labelledby="session-progress-label"
                 aria-valuemin="0"
                 aria-valuemax="100"
                 aria-valuenow="@SessionProgressPercent">
                <div class="kf-progress__value" style="@($"--kf-progress-value: {SessionProgressPercent}%")"></div>
            </div>
        </section>

        <section class="practice-audio-preferences" aria-label="@UiText.PracticeAudioSettings">
            <label>
                <span class="kf-meta">@UiText.MetronomeSource</span>
                <select value="@_metronomeAudioMode" @onchange="HandleMetronomeAudioModeChanged">
                    <option value="KeyForge">@UiText.KeyForgeMetronome</option>
                    <option value="External">@UiText.ExternalMetronome</option>
                    <option value="Off">@UiText.MetronomeOff</option>
                </select>
            </label>
            @if (_metronomeAudioMode is PracticeMetronomeMode.External)
            {
                <p class="kf-text-muted" role="note">@UiText.ExternalMetronomePhaseWarning</p>
            }
            <div class="practice-audio-preferences__activation">
                <p class="kf-text-muted">@UiText.PracticeAudioActivationDescription</p>
                <AudioActivationControl />
            </div>
        </section>

        <ExercisePresentation Exercise="exercise" />

        @if (_result is null && _runtimeExercise?.Definition is not RhythmExerciseDefinition and not SpeedExerciseDefinition and not FingerIndependenceExerciseDefinition &&
            _runtimeExercise?.Definition.Tempo is not null)
        {
            <section class="practice-tempo-tools" aria-label="@UiText.Tempo">
                <TempoSelector RuntimeExercise="_runtimeExercise"
                               OnTempoChanged="HandleTempoChanged" />
                @if (_runtimeExercise.Definition.Metronome is { Enabled: true } metronome)
                {
                    <MetronomeControl RuntimeExercise="_runtimeExercise" Configuration="metronome"
                                      AudioEnabled="IsKeyForgeMetronomeEnabled" />
                }
            </section>
        }

        @if (_result is null)
        {
            <section class="kf-card practice-workspace" aria-labelledby="@(HasInteractiveChallenge ? null : "attempt-form-title")">
                <div class="kf-card__body practice-workspace__body">
                    @if (IsRhythmChallenge)
                    {
                        <RhythmWorkspace @key="_runtimeExercise"
                                         RuntimeExercise="_runtimeExercise!"
                                         MetronomeAudioEnabled="IsKeyForgeMetronomeEnabled"
                                         OnCompleted="CompleteInteractiveAttempt" />
                    }
                    else if (IsNoteReadingChallenge)
                    {
                        <NoteReadingWorkspace @key="_runtimeExercise"
                                              RuntimeExercise="_runtimeExercise!"
                                              OnCompleted="CompleteInteractiveAttempt" />
                    }
                    else if (IsIntervalOrOctaveChallenge)
                    {
                        <IntervalOctaveWorkspace @key="_runtimeExercise"
                                                 RuntimeExercise="_runtimeExercise!"
                                                 OnCompleted="CompleteInteractiveAttempt" />
                    }
                    else if (IsMentalKeyboardChallenge)
                    {
                        <MentalKeyboardWorkspace @key="_runtimeExercise"
                                                RuntimeExercise="_runtimeExercise!"
                                                OnCompleted="CompleteInteractiveAttempt" />
                    }
                    else if (IsEarTrainingChallenge)
                    {
                        <EarTrainingWorkspace @key="_runtimeExercise"
                                              RuntimeExercise="_runtimeExercise!"
                                              OnCompleted="CompleteInteractiveAttempt" />
                    }
                    else if (_runtimeExercise?.Challenge.Performance is not null)
                    {
                        <PerformanceWorkspace @key="_runtimeExercise" RuntimeExercise="_runtimeExercise" OnCompleted="CompleteInteractiveAttempt" />
                    }
                    else if (IsSequenceChallenge)
                    {
                        <SequenceWorkspace @key="_runtimeExercise"
                                           RuntimeExercise="_runtimeExercise!"
                                           MetronomeAudioEnabled="IsKeyForgeMetronomeEnabled"
                                           OnCompleted="CompleteInteractiveAttempt" />
                    }
                    else
                    {
                        <h2 id="attempt-form-title" class="kf-card__title">@UiText.RuntimeUnavailable</h2>
                        <p class="kf-card__description practice-form-description">@UiText.RuntimeUnavailableDescription</p>
                        <div class="practice-actions practice-actions--inline">
                            <button class="kf-button kf-button--primary" type="button" @onclick="AdvanceUnsupportedExercise">
                                @(IsFinalExercise ? UiText.FinishSession : UiText.NextExercise)
                            </button>
                        </div>
                    }

                    @if (_submissionError && HasInteractiveChallenge)
                    {
                        <p class="practice-error" role="alert">@UiText.AttemptSubmissionError</p>
                    }
                </div>
            </section>
        }
        else
        {
            <section class="kf-card practice-feedback @GetResultCardClass()" role="status" aria-labelledby="attempt-result-title">
                <div class="kf-card__body">
                    <div class="kf-card__header">
                        <div>
                            <p class="kf-meta">@UiText.AttemptResult</p>
                            <h2 id="attempt-result-title" class="kf-card__title">@GetAttemptResultTitle()</h2>
                        </div>
                        <span class="kf-status-badge @GetAttemptResultBadgeClass()">@GetAttemptResultTitle()</span>
                    </div>
                    <p class="kf-card__description">@GetAttemptResultDescription()</p>
                </div>
                <ul class="kf-card__meta">
                    <li>@UiText.Score: <bdi>@_result.Score%</bdi></li>
                    @if (_result.IsExerciseCompleted)
                    {
                        <li>@UiText.ExerciseCompleted</li>
                    }
                </ul>
                @if (_result.Evaluation.Performance is { } performance)
                {
                    <PerformanceFeedback Details="performance" />
                }
                @if (_result.Evaluation.Rhythm is { } rhythm)
                {
                    <dl class="practice-result-summary">
                        <div>
                            <dt>@UiText.ExpectedBeats</dt>
                            <dd>@UiText.FormatNumber(rhythm.ExpectedBeatCount)</dd>
                        </div>
                        <div>
                            <dt>@UiText.SuccessfulHits</dt>
                            <dd>@UiText.FormatNumber(rhythm.SuccessfulHitCount)</dd>
                        </div>
                        <div>
                            <dt>@UiText.MissedBeats</dt>
                            <dd>@UiText.FormatNumber(rhythm.MissedBeatCount)</dd>
                        </div>
                        <div>
                            <dt>@UiText.ExtraHits</dt>
                            <dd>@UiText.FormatNumber(rhythm.ExtraHitCount)</dd>
                        </div>
                        <div>
                            <dt>@UiText.AverageTimingError</dt>
                            <dd>@UiText.FormatTimingError(rhythm.AverageAbsoluteTimingErrorMilliseconds)</dd>
                        </div>
                        <div>
                            <dt>@UiText.TimingTendency</dt>
                            <dd>@UiText.GetRhythmTimingTendency(rhythm.TimingTendency)</dd>
                        </div>
                    </dl>
                    <div class="practice-result-events" role="region" aria-label="@UiText.ExpectedBeats">
                        @foreach (var beat in rhythm.Beats)
                        {
                            <dl class="practice-result-events__item">
                                <div><dt>@UiText.ExpectedOnset</dt><dd>@UiText.FormatOffset(beat.ExpectedOffset)</dd></div>
                                <div><dt>@UiText.ActualOnset</dt><dd>@UiText.FormatOffset(beat.ActualOffset)</dd></div>
                                <div><dt>@UiText.SignedTimingError</dt><dd>@UiText.FormatTimingError(beat.TimingError?.TotalMilliseconds)</dd></div>
                                <div><dt>@UiText.TimingAccuracy</dt><dd>@beat.Accuracy</dd></div>
                            </dl>
                        }
                        @foreach (var offset in rhythm.UnexpectedHitOffsets)
                        {
                            <dl class="practice-result-events__item">
                                <div><dt>@UiText.ExtraHits</dt><dd>@UiText.FormatOffset(offset)</dd></div>
                            </dl>
                        }
                    </div>
                }
                @if (_result.Evaluation.NoteReading is { } noteReading)
                {
                    <dl class="practice-result-summary">
                        <div>
                            <dt>@UiText.QuestionProgress</dt>
                            <dd>@UiText.FormatNumber(noteReading.QuestionCount)</dd>
                        </div>
                        <div>
                            <dt>@UiText.CorrectAnswers</dt>
                            <dd>@UiText.FormatNumber(noteReading.CorrectAnswerCount)</dd>
                        </div>
                        <div>
                            <dt>@UiText.IncorrectAnswers</dt>
                            <dd>@UiText.FormatNumber(noteReading.IncorrectAnswerCount)</dd>
                        </div>
                    </dl>
                }
                @if (_result.Evaluation.EarTraining is { } earTraining)
                {
                    <dl class="practice-result-summary">
                        <div><dt>@UiText.QuestionProgress</dt><dd>@UiText.FormatNumber(earTraining.QuestionCount)</dd></div>
                        <div><dt>@UiText.CorrectAnswers</dt><dd>@UiText.FormatNumber(earTraining.CorrectAnswerCount)</dd></div>
                        <div><dt>@UiText.IncorrectAnswers</dt><dd>@UiText.FormatNumber(earTraining.IncorrectAnswerCount)</dd></div>
                    </dl>
                }
                @if (NoteTargetResult is { } noteTarget)
                {
                    <dl class="practice-result-summary">
                        <div><dt>@UiText.QuestionProgress</dt><dd>@UiText.FormatNumber(noteTarget.QuestionCount)</dd></div>
                        <div><dt>@UiText.CorrectAnswers</dt><dd>@UiText.FormatNumber(noteTarget.CorrectAnswerCount)</dd></div>
                        <div><dt>@UiText.IncorrectAnswers</dt><dd>@UiText.FormatNumber(noteTarget.IncorrectAnswerCount)</dd></div>
                    </dl>
                }
                @if ((_result.Evaluation.Speed ?? _result.Evaluation.FingerIndependence ?? _result.Evaluation.Sequence) is { } sequence)
                {
                    <dl class="practice-result-summary">
                        @if (SequenceExpectedNotes.Count > 0)
                        {
                            <div><dt>@UiText.ExpectedSequence</dt><dd><bdi>@string.Join(UiText.ListSeparator, SequenceExpectedNotes)</bdi></dd></div>
                        }
                        <div><dt>@UiText.CorrectInputs</dt><dd>@UiText.FormatNumber(sequence.CorrectInputCount)</dd></div>
                        @if (sequence.Notes.Count > 0 && sequence.Notes.Any(note => note.ExpectedOffset.HasValue))
                        {
                            <div><dt>@UiText.PitchAccuracy</dt><dd>@UiText.FormatNumber(sequence.CorrectPitchCount) / @UiText.FormatNumber(sequence.ExpectedInputCount)</dd></div>
                            <div><dt>@UiText.TimingAccuracy</dt><dd>@UiText.FormatNumber(sequence.CorrectTimingCount) / @UiText.FormatNumber(sequence.ExpectedInputCount)</dd></div>
                        }
                        <div><dt>@UiText.MissedInputs</dt><dd>@UiText.FormatNumber(sequence.MissedInputCount)</dd></div>
                        <div><dt>@UiText.IncorrectInputs</dt><dd>@UiText.FormatNumber(sequence.IncorrectInputCount)</dd></div>
                        <div><dt>@UiText.ExtraInputs</dt><dd>@UiText.FormatNumber(sequence.ExtraInputCount)</dd></div>
                        @if (sequence.AverageAbsoluteTimingErrorMilliseconds.HasValue)
                        {
                            <div><dt>@UiText.AverageTimingError</dt><dd>@UiText.FormatTimingError(sequence.AverageAbsoluteTimingErrorMilliseconds)</dd></div>
                            <div><dt>@UiText.TimingTendency</dt><dd>@UiText.GetRhythmTimingTendency(sequence.TimingTendency)</dd></div>
                        }
                    </dl>
                    @if (sequence.Notes.Count > 0 && sequence.Notes.Any(note => note.ExpectedOffset.HasValue))
                    {
                        <div class="practice-result-events" role="region" aria-label="@UiText.ExpectedSequence">
                            @foreach (var note in sequence.Notes)
                            {
                                <dl class="practice-result-events__item">
                                    <div><dt>@UiText.ExpectedNote</dt><dd><bdi>@note.ExpectedNote</bdi></dd></div>
                                    <div><dt>@UiText.YourNote</dt><dd><bdi>@(note.ActualNote ?? UiText.Missed)</bdi></dd></div>
                                    <div><dt>@UiText.ExpectedOnset</dt><dd>@UiText.FormatOffset(note.ExpectedOffset)</dd></div>
                                    <div><dt>@UiText.ActualOnset</dt><dd>@UiText.FormatOffset(note.ActualOffset)</dd></div>
                                    <div><dt>@UiText.SignedTimingError</dt><dd>@UiText.FormatTimingError(note.TimingError?.TotalMilliseconds)</dd></div>
                                    <div><dt>@UiText.PitchAccuracy</dt><dd>@(note.IsPitchCorrect ? UiText.Correct : UiText.Incorrect)</dd></div>
                                    @if (note.IsTimingCorrect.HasValue)
                                    {
                                        <div><dt>@UiText.TimingAccuracy</dt><dd>@(note.IsTimingCorrect.Value ? UiText.Correct : UiText.Incorrect)</dd></div>
                                    }
                                </dl>
                            }
                            @foreach (var extra in sequence.UnexpectedNotes)
                            {
                                <dl class="practice-result-events__item">
                                    <div><dt>@UiText.ExtraInputs</dt><dd><bdi>@extra.ActualNote</bdi></dd></div>
                                    <div><dt>@UiText.ActualOnset</dt><dd>@UiText.FormatOffset(extra.ActualOffset)</dd></div>
                                </dl>
                            }
                        </div>
                    }
                }
                <div class="practice-actions">
                    <button class="kf-button kf-button--secondary" type="button" @onclick="RetryCurrentExercise">
                        @UiText.RetryExercise
                    </button>
                    <button class="kf-button kf-button--primary" type="button" @onclick="AdvanceSession">
                        @(IsFinalExercise ? UiText.FinishSession : UiText.NextExercise)
                    </button>
                </div>
            </section>
        }

        @if (_result is null && SupportsMidiInput)
        {
            <details class="practice-midi-panel">
                <summary>
                    @UiText.Midi
                    <span class="practice-midi-panel__hint">@UiText.OptionalMidi</span>
                </summary>
                <div class="practice-midi-panel__content">
                    <fieldset class="practice-midi-mode">
                        <legend>@UiText.MidiAudioMode</legend>
                        <label>
                            <input type="radio" name="midi-audio-mode" value="external"
                                   checked="@(!_internalMidiAudioEnabled)"
                                   @onchange="() => SetMidiAudioMode(false)" />
                            @UiText.ExternalDawMode
                        </label>
                        <label>
                            <input type="radio" name="midi-audio-mode" value="internal"
                                   checked="@_internalMidiAudioEnabled"
                                   @onchange="() => SetMidiAudioMode(true)" />
                            @UiText.InternalAudioMode
                        </label>
                        <p class="kf-text-muted">@(_internalMidiAudioEnabled ? UiText.InternalAudioModeDescription : UiText.ExternalDawModeDescription)</p>
                    </fieldset>
                    <MidiInputControl LivePlayEnabled="_internalMidiAudioEnabled" />
                </div>
            </details>
        }
    </div>
}

@code {
    [Parameter]
    public string LessonId { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "exercise")]
    public string? ExerciseId { get; set; }

    private PracticeStartState _startState;
    private LessonDefinition? _lesson;
    private LessonListItem? _lessonState;
    private PracticeSession? _session;
    private RuntimeExercise? _runtimeExercise;
    private SessionResult? _result;
    private SessionResult? _lastResult;
    private bool _isSubmitting;
    private bool _submissionError;
    private bool _internalMidiAudioEnabled;
    private PracticeMetronomeMode _metronomeAudioMode = PracticeMetronomeMode.KeyForge;
    private bool IsKeyForgeMetronomeEnabled => _metronomeAudioMode is PracticeMetronomeMode.KeyForge;

    private void SetMidiAudioMode(bool enabled) => _internalMidiAudioEnabled = enabled;

    private void HandleMetronomeAudioModeChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse<PracticeMetronomeMode>(args.Value?.ToString(), out var mode))
        {
            _metronomeAudioMode = mode;
        }
    }

    private ExerciseDefinition? CurrentExercise => _session?.GetCurrentExercise();
    private bool HasInteractiveChallenge => _runtimeExercise?.Challenge.ExpectedInputs.Count > 0;
    private bool IsRhythmChallenge =>
        _runtimeExercise?.Definition is RhythmExerciseDefinition && HasInteractiveChallenge;
    private bool IsNoteReadingChallenge =>
        _runtimeExercise?.Definition is NoteReadingExerciseDefinition && HasInteractiveChallenge;
    private bool IsIntervalOrOctaveChallenge =>
        _runtimeExercise?.Definition is IntervalExerciseDefinition or OctaveExerciseDefinition && HasInteractiveChallenge;
    private bool IsMentalKeyboardChallenge =>
        _runtimeExercise?.Definition is MentalKeyboardExerciseDefinition && HasInteractiveChallenge;
    private bool IsEarTrainingChallenge =>
        _runtimeExercise?.Definition is EarTrainingExerciseDefinition && HasInteractiveChallenge;
    private bool IsSequenceChallenge =>
        _runtimeExercise?.Definition is SpeedExerciseDefinition or FingerIndependenceExerciseDefinition or SequenceExerciseDefinition && HasInteractiveChallenge;
    private bool SupportsMidiInput => _runtimeExercise?.Definition is RhythmExerciseDefinition or NoteReadingExerciseDefinition or
        IntervalExerciseDefinition or OctaveExerciseDefinition or MentalKeyboardExerciseDefinition or EarTrainingExerciseDefinition or
        SpeedExerciseDefinition or FingerIndependenceExerciseDefinition or SequenceExerciseDefinition;
    private NoteTargetEvaluationDetails? NoteTargetResult => _result?.Evaluation.Interval ??
        _result?.Evaluation.Octave ?? _result?.Evaluation.MentalKeyboard;
    private IReadOnlyList<string> SequenceExpectedNotes => _runtimeExercise?.Challenge.Speed?.ExpectedNotes ??
        _runtimeExercise?.Challenge.FingerIndependence?.ExpectedNotes ??
        _runtimeExercise?.Challenge.Sequence?.ExpectedNotes ?? [];
    private int CurrentExerciseNumber => (_session?.CurrentExerciseIndex ?? 0) + 1;
    private int SessionProgressPercent => _session?.Exercises.Count > 0
        ? (int)Math.Round(CurrentExerciseNumber * 100d / _session.Exercises.Count)
        : 100;
    private bool IsFinalExercise =>
        _session is not null && _session.CurrentExerciseIndex == _session.Exercises.Count - 1;

    protected override void OnParametersSet()
    {
        ResetPageState();

        if (string.IsNullOrWhiteSpace(LessonId))
        {
            _startState = PracticeStartState.NotFound;
            return;
        }

        try
        {
            _lesson = LessonCatalog.GetById(LessonId);
            _session = PracticeSessionService.StartSession(LessonId);
        }
        catch (InvalidOperationException)
        {
            _startState = PracticeStartState.Locked;
            return;
        }
        catch (ArgumentException)
        {
            _startState = PracticeStartState.NotFound;
            return;
        }
        catch (Exception)
        {
            _startState = PracticeStartState.Error;
            return;
        }

        if (_session is null)
        {
            _startState = PracticeStartState.NotFound;
            return;
        }

        if (!string.IsNullOrWhiteSpace(ExerciseId))
        {
            var selectedIndex = -1;
            for (var index = 0; index < _session.Exercises.Count; index++)
            {
                if (string.Equals(_session.Exercises[index].Id, ExerciseId, StringComparison.OrdinalIgnoreCase))
                {
                    selectedIndex = index;
                    break;
                }
            }

            if (selectedIndex < 0)
            {
                _startState = PracticeStartState.NotFound;
                _session = null;
                return;
            }

            while (_session.CurrentExerciseIndex < selectedIndex)
            {
                _session.Next();
            }
        }

        _startState = PracticeStartState.Ready;

        // A data-driven exercise definition may fail to build its runtime
        // challenge; that is a start error, not a locked lesson.
        PrepareRuntimeOrShowError();
        RefreshLessonState();
    }

    private void CompleteInteractiveAttempt(DateTime completedAt)
    {
        if (_isSubmitting || _session is null || _runtimeExercise is null || !HasInteractiveChallenge)
        {
            return;
        }

        _isSubmitting = true;
        _submissionError = false;

        try
        {
            _result = PracticeSessionService.SubmitAttempt(_session, _runtimeExercise, completedAt);
            _lastResult = _result;
            ProgressUpdateService.UpdateProgress(_session.LessonId, _result);
            RefreshLessonState();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _submissionError = true;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void RetryCurrentExercise()
    {
        var selectedBpm = _runtimeExercise?.SelectedBpm;
        _result = null;
        PrepareRuntimeOrShowError(selectedBpm);
    }

    private void AdvanceSession()
    {
        if (_session is null || _result is null)
        {
            return;
        }

        _session.Next();
        _result = null;
        PrepareRuntimeOrShowError();
        RefreshLessonState();
    }

    /// <summary>
    /// Builds the runtime for the current exercise, or degrades to the error
    /// state without leaving a stale runtime from the previous exercise.
    /// </summary>
    private void PrepareRuntimeOrShowError(int? selectedBpm = null)
    {
        try
        {
            ResetAttemptForm(selectedBpm);
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            _runtimeExercise = null;
            _startState = PracticeStartState.Error;
        }
    }

    private void AdvanceUnsupportedExercise()
    {
        if (_session is null || HasInteractiveChallenge)
        {
            return;
        }

        _session.Next();
        ResetAttemptForm();
        RefreshLessonState();
    }

    private void RefreshLessonState()
    {
        _lessonState = LessonQuery.GetLessons().FirstOrDefault(lesson =>
            string.Equals(lesson.Id, LessonId, StringComparison.OrdinalIgnoreCase));
    }

    private string GetLibraryUrl()
    {
        if (_lesson is null)
        {
            return "/lessons";
        }

        var exerciseId = CurrentExercise?.Id ?? ExerciseId;
        return string.IsNullOrWhiteSpace(exerciseId)
            ? $"/lessons?lesson={Uri.EscapeDataString(_lesson.Id)}"
            : $"/lessons?lesson={Uri.EscapeDataString(_lesson.Id)}&exercise={Uri.EscapeDataString(exerciseId)}";
    }

    private void ResetPageState()
    {
        _startState = PracticeStartState.Ready;
        _lesson = null;
        _lessonState = null;
        _session = null;
        _runtimeExercise = null;
        _result = null;
        _lastResult = null;
        _submissionError = false;
    }

    private Task HandleTempoChanged(int _) => InvokeAsync(StateHasChanged);

    private void ResetAttemptForm(int? selectedBpm = null)
    {
        _runtimeExercise = _session is { IsFinished: false }
            ? PracticeSessionService.StartExercise(_session)
            : null;
        if (selectedBpm is { } bpm && _runtimeExercise?.Definition.Tempo is { AllowUserChange: true } &&
            _runtimeExercise.SelectedBpm != bpm)
        {
            _runtimeExercise.SetSelectedBpm(bpm);
        }
        _submissionError = false;
    }

    private string GetAttemptResultTitle() =>
        _result?.IsSuccessful == true ? UiText.AttemptSuccessful : UiText.AttemptFailed;

    private string GetAttemptResultDescription() =>
        _result?.IsSuccessful == true
            ? UiText.AttemptSuccessfulDescription
            : UiText.AttemptFailedDescription;

    private string GetAttemptResultBadgeClass() =>
        _result?.IsSuccessful == true
            ? "kf-status-badge--completed"
            : "kf-status-badge--locked";

    private string GetResultCardClass() =>
        _result?.IsSuccessful == true
            ? "practice-result--success"
            : "practice-result--failed";

    private string GetLessonCompletionLabel() =>
        _lessonState?.IsCompleted == true ? UiText.LessonCompleted : UiText.LessonIncomplete;

    private string GetLessonCompletionBadgeClass() =>
        _lessonState?.IsCompleted == true
            ? "kf-status-badge--completed"
            : "kf-status-badge--locked";

    private enum PracticeStartState
    {
        Ready,
        NotFound,
        Locked,
        Error
    }
}
