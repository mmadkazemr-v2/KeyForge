@page "/import"
@rendermode InteractiveServer
@using KeyForge.Infrastructure.Content.Import
@inject ILogger<Import> Logger

<PageTitle>@T("ورود MusicXML", "Import MusicXML")</PageTitle>
<h1>@T("وارد کردن بخش هنرجو از MusicXML", "Import a MusicXML learner part")</h1>
<p>@T("فایل MusicXML را انتخاب کنید، سپس بخش هنرجو را مشخص کنید.", "Choose your MusicXML file, then explicitly select the learner part.")</p>
<InputFile OnChange="ReadAsync" accept=".musicxml,.xml" />
@if (_xml is not null)
{
    <label>@T("بخش هنرجو", "Learner part")
        <select @bind="_part">
            <option value="">@T("انتخاب یک بخش", "Select a part")</option>
            @foreach (var part in _parts)
            {
                <option value="@part.Id">@part.Name (@part.Id)</option>
            }
        </select>
    </label>
    <label>@T("شناسه ثابت درس", "Stable lesson ID") <input @bind="_lessonId"/></label>
    <label>@T("تمپو (BPM) در صورت نبود در منبع", "BPM when absent from source") <input type="number" min="10" max="400"
                                                                                       @bind="_bpm"/></label>
    <button class="kf-button kf-button--primary" type="button"
            @onclick="Preview">@T("اعتبارسنجی و پیش‌نمایش", "Validate and preview")</button>
}
@if (_yaml is not null)
{
    <p>@T("زمان‌بندی نسبت به اولین ضربه شماست. دست، انگشت‌گذاری و نت‌نویسی دقیق استنباط نمی‌شوند.", "Timing is relative to your first attack. Hand, fingering and exact notation are not inferred.")</p>
    <p>@T("پس از بررسی، فایل YAML را در پوشه محتوای درس که تنظیم شده ذخیره کنید و برنامه را دوباره اجرا کنید؛ سپس درس در کتابخانه در دسترس خواهد بود.", "After review, save the YAML in the configured lesson-content directory and restart the app; the lesson will then be available in the library.")</p>
    <p>@T("YAML تولیدشده فقط زمان شروع نت‌ها را امتیازدهی می‌کند. مدت‌ها حفظ می‌شوند؛ برای ارزیابی نگه‌داشتن کلید، scoringMode: keyHold را بنویسید.", "Generated YAML scores onsets only. Durations are preserved; author scoringMode: keyHold to assess key holds.")</p>
    <a class="kf-button kf-button--secondary" download="@(_previewId + ".yaml")"
       href="@DownloadUrl">@T("دانلود YAML اعتبارسنجی‌شده", "Download validated YAML")</a>
    <pre dir="ltr">@_yaml</pre>
}
@if (_error is not null)
{
    <p role="alert">@_error</p>
}
<p>@T("از فایل‌های ثابت‌تمپوی MusicXML با مدت‌زمان مشخص نت‌ها پشتیبانی می‌شود. وارد کردن MIDI و فایل فشردهٔ MXL هنوز پشتیبانی نمی‌شود.", "Supports uncompressed, fixed-tempo MusicXML with explicit note durations. MIDI and compressed MXL import are not supported yet.")</p>

@code {
    private readonly MusicXmlPerformanceImporter _importer = new();
    private string? _xml, _yaml, _error, _previewId;
    private string _part = "";
    private string _lessonId = "import-" + Guid.NewGuid().ToString("N");
    private int _bpm = 60;
    private IReadOnlyList<(string Id, string Name)> _parts = [];
    private string DownloadUrl => "data:text/yaml;charset=utf-8;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(_yaml!));
    private static string T(string fa, string en) => UiText.IsPersian ? fa : en;

    private async Task ReadAsync(InputFileChangeEventArgs args)
    {
        _xml = _yaml = _error = _previewId = null;
        _parts = [];
        _part = "";
        try
        {
            var extension = Path.GetExtension(args.File.Name);
            if (!extension.Equals(".xml", StringComparison.OrdinalIgnoreCase) &&
                !extension.Equals(".musicxml", StringComparison.OrdinalIgnoreCase))
            {
                _error = T("پسوند فایل باید .xml یا .musicxml باشد.", "Choose a .xml or .musicxml file.");
                return;
            }

            switch (args.File.Size)
            {
                case 0:
                    _error = T("فایل خالی است.", "The selected file is empty.");
                    return;
                case > MusicXmlPerformanceImporter.MaximumCharacters:
                    _error = T("حجم فایل از حد مجاز بیشتر است.", "The selected file exceeds the import size limit.");
                    return;
            }

            using var reader = new StreamReader(args.File.OpenReadStream(MusicXmlPerformanceImporter.MaximumCharacters));
            var xml = await reader.ReadToEndAsync();
            _parts = _importer.GetParts(xml);
            if (_parts.Count == 0)
            {
                _error = T("این فایل بخش موسیقایی قابل واردکردن ندارد.", "This file contains no importable parts.");
                return;
            }
            _xml = xml;
        }
        catch (InvalidDataException)
        {
            _error = T("فایل MusicXML معتبر نیست یا این قالب پشتیبانی نمی‌شود.", "The MusicXML file is invalid or uses an unsupported format.");
        }
        catch (IOException)
        {
            _error = T("خواندن فایل ممکن نشد. دوباره انتخابش کنید.", "The file could not be read. Please select it again.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while reading a MusicXML import.");
            _error = T("هنگام خواندن فایل خطایی رخ داد.", "An unexpected error occurred while reading the file.");
        }
    }

    private void Preview()
    {
        _yaml = _error = null;
        try
        {
            _yaml = _importer.Import(_xml!, _part, _lessonId, "imported-performance", _bpm);
            _previewId = _lessonId;
        }
        catch (Exception ex) when (ex is InvalidDataException or InvalidOperationException or ArgumentException or YamlLessonParseException)
        {
            _error = T("اعتبارسنجی انجام نشد. بخش، شناسه درس و داده‌های موسیقی را بررسی کنید.", "Validation failed. Check the selected part, lesson ID, and musical data.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while previewing a MusicXML import.");
            _error = T("پیش‌نمایش ساخته نشد. فایل را بررسی کنید و دوباره تلاش کنید.", "The preview could not be created. Check the file and try again.");
        }
    }

}
