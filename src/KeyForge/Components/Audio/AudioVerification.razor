@namespace KeyForge.Components.Audio
@inject IAudioPlaybackService Audio
@inject ILessonCatalog LessonCatalog
@inject IPracticeSessionService PracticeSessions
@implements IAsyncDisposable

<section class="kf-card" aria-labelledby="audio-verification-title">
    <div class="kf-card__body">
        <div class="kf-card__header">
            <div>
                <p class="kf-meta">@UiText.AudioVerification</p>
                <h2 id="audio-verification-title" class="kf-card__title">@UiText.GetAudioStatusLabel(Audio.State)</h2>
            </div>
            <span class="kf-status-badge @GetStateClass()">@UiText.GetAudioStatusLabel(Audio.State)</span>
        </div>
        <p class="kf-card__description">@UiText.AudioVerificationDescription</p>
    </div>
    <div class="kf-card__body">
        <div class="practice-actions practice-actions--inline">
            @if (Audio.State == AudioPlaybackState.Ready)
            {
                <button class="kf-button kf-button--secondary" type="button" @onclick='() => PlayNoteAsync("C4")'>@UiText.PlayNote C4</button>
                <button class="kf-button kf-button--secondary" type="button" @onclick='() => PlayNoteAsync("E4")'>@UiText.PlayNote E4</button>
                <button class="kf-button kf-button--secondary" type="button" @onclick='() => PlayNoteAsync("G4")'>@UiText.PlayNote G4</button>
                <button class="kf-button kf-button--secondary" type="button" @onclick='() => PlayNoteAsync("C5")'>@UiText.PlayNote C5</button>
                <button class="kf-button kf-button--secondary" type="button" @onclick="PlayMetronomeAsync">@UiText.MetronomeClick</button>
            }
            else
            {
                <AudioActivationControl />
            }
        </div>
    </div>
</section>

@if (_runtime is not null && _runtime.Definition.Metronome is { } configuration)
{
    <TempoSelector RuntimeExercise="_runtime" IsDisabled="_metronomeRunning" OnTempoChanged="RefreshTempo" />
    <MetronomeControl RuntimeExercise="_runtime" Configuration="configuration" OnRunningChanged="SetMetronomeRunning" />
}

@code {
    private RuntimeExercise? _runtime;
    private bool _metronomeRunning;

    protected override void OnInitialized()
    {
        Audio.StateChanged += Refresh;
        // Reuse configured lesson content and the real practice controls.
        var lesson = LessonCatalog.GetAll().FirstOrDefault(lesson =>
            lesson.Exercises.FirstOrDefault() is { Tempo: not null, Metronome.Enabled: true });
        if (lesson is not null && PracticeSessions.StartSession(lesson.Id) is { } session)
            _runtime = PracticeSessions.StartExercise(session);
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    private Task RefreshTempo(int _) => InvokeAsync(StateHasChanged);
    private void SetMetronomeRunning(bool running) => _metronomeRunning = running;
    public async ValueTask DisposeAsync()
    {
        Audio.StateChanged -= Refresh;
        await Audio.StopActiveNotesAsync();
    }

    private async Task PlayNoteAsync(string note) => await Audio.PlayNoteAsync(MusicalNote.Parse(note));
    private Task PlayMetronomeAsync() => Audio.PlayMetronomeClickAsync();

    private string GetStateClass() => Audio.State == AudioPlaybackState.Ready
        ? "kf-status-badge--completed"
        : Audio.State == AudioPlaybackState.Failed ? "kf-status-badge--locked" : "kf-status-badge--available";
}
