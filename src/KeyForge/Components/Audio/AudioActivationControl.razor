@namespace KeyForge.Components.Audio
@inject IAudioPlaybackService Audio
@implements IDisposable

<div class="audio-activation">
    <span class="kf-status-badge @(Audio.State == AudioPlaybackState.Ready ? "kf-status-badge--completed" : "kf-status-badge--available")">
        @UiText.GetAudioStatusLabel(Audio.State)
    </span>
    <button class="kf-button @(Audio.State == AudioPlaybackState.Ready ? "kf-button--secondary" : "kf-button--primary")" type="button"
            @ref="_button"
            disabled="@(Audio.State == AudioPlaybackState.Initializing)"
            aria-busy="@(Audio.State == AudioPlaybackState.Initializing)"
            @onclick="EnableAsync">
        @(Audio.State == AudioPlaybackState.Initializing ? UiText.AudioActivating :
            Audio.State == AudioPlaybackState.Ready ? UiText.CheckOrResumeAudio : UiText.EnableAudio)
    </button>
    @if (Audio.State is AudioPlaybackState.Failed or AudioPlaybackState.Suspended)
    {
        <p class="audio-activation__error" role="status">
            @UiText.GetAudioFailureMessage(Audio.FailureReason)
        </p>
    }
</div>

@code {
    private ElementReference _button;
    private bool _prepared;

    protected override void OnInitialized() => Audio.StateChanged += Refresh;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_prepared)
        {
            _prepared = true;
            await Audio.PrepareActivationAsync(_button);
        }
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Audio.StateChanged -= Refresh;

    /// <summary>Checks or resumes Tone.js from this explicit user click.</summary>
    private async Task EnableAsync()
    {
        await Audio.InitializeAsync();
    }
}
