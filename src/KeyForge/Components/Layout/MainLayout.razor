@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content kf-page-container">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @UiText.UnexpectedError
    <a href="." class="reload">@UiText.Reload</a>
    <span class="dismiss">🗙</span>
</div>
